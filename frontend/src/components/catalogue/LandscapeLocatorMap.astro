---
/**
 * LandscapeLocatorMap — self-contained inline-SVG world locator with
 * click-to-zoom.
 *
 * Draws the CANONICAL living-landscape delineations (approved 2026-07-21,
 * simplified for display — data/landscape_outlines.json, built from
 * MOSAIC_catalog/boundaries/ by scripts/build_map_outlines.py) plus one
 * centroid dot per landscape (data/landscape_centroids.json, joined to
 * dataset counts at build time). Most landscapes are too small to read at
 * world scale, so the dots and code labels stay the primary markers.
 *
 * Clicking a landscape (dot, code label or boundary) animates the SVG
 * viewBox to that landscape's bbox (letterboxed into the map aspect, the
 * boundary capped at ~70% of the frame). While zoomed, an HTML info chip
 * carries the name, country, dataset count, the "View datasets" link (the
 * navigation the dots used to do) and a "World view" reset. Escape, the
 * reset button, or clicking outside the boundary zoom back out. The zoom
 * logic is vanilla TS in the component <script> — no runtime deps.
 *
 * The land silhouette is Natural Earth 110m land, decoded offline from a
 * TopoJSON into a single equirectangular SVG path (data/world_land_path.json,
 * projection: x = lon + 180, y = 90 − lat). It stays 110m-coarse when
 * zoomed — context only. No runtime fetch, no map tiles, no extra
 * dependencies — builds and previews fully offline.
 *
 * Labels are placed with a small greedy de-collision pass (fans crowded codes
 * outward and draws a thin leader line back to the dot).
 *
 * Global / cross-landscape (GLB) datasets have no meaningful point and are
 * not plotted; the caption notes how many there are.
 */
import centroidData from '../../../data/landscape_centroids.json'
import outlineData from '../../../data/landscape_outlines.json'
import world from '../../../data/world_land_path.json'

interface LandscapePoint {
  code: string
  name: string
  country: string | null
  count: number
  lon: number
  lat: number
  fallback: boolean
}

interface Outline {
  d: string
  bbox: number[] // projected [x0, y0, x1, y1]
}

const points = centroidData.landscapes as LandscapePoint[]
const outlines = outlineData.outlines as Record<string, Outline>
const globalCount = centroidData._meta.global_datasets_not_plotted ?? 0
const base = import.meta.env.BASE_URL

// ── Equirectangular projection (must match world_land_path.json) ─────
const projX = (lon: number) => lon + 180
const projY = (lat: number) => 90 - lat

// Crop window — a wide world strip framing every landscape with context.
const LON_LEFT = -128
const LON_RIGHT = 162
const LAT_TOP = 60
const LAT_BOTTOM = -54
const VB_X = projX(LON_LEFT)
const VB_Y = projY(LAT_TOP)
const VB_W = projX(LON_RIGHT) - projX(LON_LEFT)
const VB_H = projY(LAT_BOTTOM) - projY(LAT_TOP)

// Radius scales gently with dataset count.
const rOf = (count: number) => 1.6 + Math.min(count, 20) * 0.2

// Graticule (faint dashed orientation lines).
const meridians = [-120, -90, -60, -30, 0, 30, 60, 90, 120, 150]
const parallels = [40, 20, 0, -20, -40]

// ── Label layout: fan crowded codes outward, add leader lines ────────
const FS = 2.9 // label font size, viewBox units
const CW = 1.62 // approximate glyph width
const LH = 3.0 // label box height

type Box = { x0: number; y0: number; x1: number; y1: number }
const overlaps = (a: Box, b: Box) =>
  a.x0 < b.x1 && b.x0 < a.x1 && a.y0 < b.y1 && b.y0 < a.y1

// Where the label box meets the line back to the dot (leader anchor on box edge).
const edgePoint = (box: Box, tx: number, ty: number) => {
  const bx = (box.x0 + box.x1) / 2
  const by = (box.y0 + box.y1) / 2
  const dx = tx - bx
  const dy = ty - by
  if (dx === 0 && dy === 0) return { x: bx, y: by }
  const hw = (box.x1 - box.x0) / 2
  const hh = (box.y1 - box.y0) / 2
  const s = Math.min(
    dx !== 0 ? hw / Math.abs(dx) : Infinity,
    dy !== 0 ? hh / Math.abs(dy) : Infinity,
  )
  return { x: bx + dx * s, y: by + dy * s }
}

// Candidate directions (deg, screen space: −90 = up) and push distances.
const ANGLES = [-90, -52, 52, -128, 128, 0, 180, -28, 28, 90]
const margin = 1

type Placed = {
  p: LandscapePoint
  cx: number
  cy: number
  r: number
  lx: number
  ly: number
  line: { x1: number; y1: number; x2: number; y2: number } | null
}

// All dot halos are obstacles for every label.
const dotBoxes: Box[] = points.map((p) => {
  const x = projX(p.lon)
  const y = projY(p.lat)
  const r = rOf(p.count) + 1.6
  return { x0: x - r, y0: y - r, x1: x + r, y1: y + r }
})

const labelBoxes: Box[] = []
const layout: Placed[] = []

for (const p of [...points].sort((a, b) => b.count - a.count)) {
  const cx = projX(p.lon)
  const cy = projY(p.lat)
  const r = rOf(p.count)
  const w = p.code.length * CW
  const base0 = r + 1.4 + LH / 2
  const dists = [base0, base0 + 2, base0 + 4.5, base0 + 7.5, base0 + 11]

  let best: { lx: number; ly: number; box: Box } | null = null
  for (const d of dists) {
    for (const a of ANGLES) {
      const rad = (a * Math.PI) / 180
      const lx = cx + d * Math.cos(rad)
      const ly = cy + d * Math.sin(rad)
      const box: Box = { x0: lx - w / 2, y0: ly - LH / 2, x1: lx + w / 2, y1: ly + LH / 2 }
      if (box.x0 < VB_X + margin || box.x1 > VB_X + VB_W - margin) continue
      if (box.y0 < VB_Y + margin || box.y1 > VB_Y + VB_H - margin) continue
      if (dotBoxes.some((b) => overlaps(box, b))) continue
      if (labelBoxes.some((b) => overlaps(box, b))) continue
      best = { lx, ly, box }
      break
    }
    if (best) break
  }
  // Fallback: place above, ignoring collisions, so every code still shows.
  if (!best) {
    const lx = cx
    const ly = cy - base0
    best = { lx, ly, box: { x0: lx - w / 2, y0: ly - LH / 2, x1: lx + w / 2, y1: ly + LH / 2 } }
  }

  labelBoxes.push(best.box)

  // Leader line: dot edge → label box edge, only when the label was pushed out.
  const dx = best.lx - cx
  const dy = best.ly - cy
  const dist = Math.hypot(dx, dy) || 1
  const dotEdge = { x: cx + (dx / dist) * (r + 1.4), y: cy + (dy / dist) * (r + 1.4) }
  const labelEdge = edgePoint(best.box, cx, cy)
  const leaderLen = Math.hypot(labelEdge.x - dotEdge.x, labelEdge.y - dotEdge.y)
  const line =
    leaderLen > 1.1
      ? { x1: dotEdge.x, y1: dotEdge.y, x2: labelEdge.x, y2: labelEdge.y }
      : null

  layout.push({ p, cx, cy, r, lx: best.lx, ly: best.ly, line })
}

// Human-readable count phrase, shared by tooltips / labels.
const countPhrase = (n: number) =>
  n === 0 ? 'no datasets yet' : `${n} dataset${n === 1 ? '' : 's'}`

// ── Payload for the client-side zoom script ──────────────────────────
const payload = {
  base,
  world: [VB_X, VB_Y, VB_W, VB_H],
  landscapes: Object.fromEntries(
    points
      .filter((p) => outlines[p.code])
      .map((p) => [
        p.code,
        { name: p.name, country: p.country, count: p.count, bbox: outlines[p.code].bbox },
      ]),
  ),
}
// <-escape so the inline JSON can never close its own <script> tag.
const payloadJson = JSON.stringify(payload).replace(/</g, '\\u003c')
---

<section class="locator" aria-labelledby="locator-heading">
  <div class="locator-head">
    <h2 id="locator-heading" class="locator-title">Where the datasets sit</h2>
    <p class="locator-sub">
      The Living Landscapes connected through MOSAIC, shown with their delineated
      boundaries (simplified for display). Dot size reflects how many datasets are
      registered for each landscape. <strong>Click a landscape</strong> — its dot,
      code or boundary — to zoom to its delineation; press Escape or choose
      “World view” to return.
    </p>

    <ul class="locator-legend" aria-hidden="false">
      <li><span class="locator-key locator-key--boundary"></span> Delineated landscape boundary (simplified)</li>
      <li><span class="locator-key locator-key--landscape"></span> Landscape centroid, sized by dataset count</li>
    </ul>
  </div>

  <div class="locator-figure">
    <svg
      class="locator-svg"
      viewBox={`${VB_X} ${VB_Y} ${VB_W} ${VB_H}`}
      role="img"
      aria-label="World map of MOSAIC Living Landscapes. Click a landscape to zoom to its delineated boundary; each dot marks a landscape centroid sized by dataset count."
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        <linearGradient id="locator-sea" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#F0F6F6" />
          <stop offset="100%" stop-color="#E4EFEF" />
        </linearGradient>
        <linearGradient id="locator-land" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#AAC8C0" />
          <stop offset="100%" stop-color="#9ABBB3" />
        </linearGradient>
      </defs>

      <!-- Sea / backdrop -->
      <rect x={VB_X} y={VB_Y} width={VB_W} height={VB_H} fill="url(#locator-sea)" />

      <!-- Graticule -->
      <g class="locator-graticule" stroke="#C6DCDC" stroke-width="0.18" stroke-dasharray="1.4 1.6" opacity="0.9">
        {meridians.map((lon) => (
          <line x1={projX(lon)} y1={VB_Y} x2={projX(lon)} y2={VB_Y + VB_H} />
        ))}
        {parallels.map((lat) => (
          <line x1={VB_X} y1={projY(lat)} x2={VB_X + VB_W} y2={projY(lat)} />
        ))}
      </g>

      <!-- Land silhouette (kept as context when zoomed) -->
      <path d={world.d} fill="url(#locator-land)" stroke="#85ABA3" stroke-width="0.18" stroke-linejoin="round" vector-effect="non-scaling-stroke" />

      <!-- Landscape boundaries (canonical delineations, simplified for display) -->
      <g
        class="locator-outlines"
        fill="var(--mosaic-teal)"
        fill-opacity="0.25"
        fill-rule="evenodd"
        stroke="var(--mosaic-teal)"
        stroke-linejoin="round"
      >
        {Object.entries(outlines).map(([code, o]) => (
          <path class="locator-outline" d={o.d} data-code={code} vector-effect="non-scaling-stroke" />
        ))}
      </g>

      <!-- Leader lines (under the labels) -->
      <g class="locator-leaders" stroke="#5F8079" stroke-width="0.28" opacity="0.85">
        {layout.map((m) => m.line && (
          <line x1={m.line.x1} y1={m.line.y1} x2={m.line.x2} y2={m.line.y2} />
        ))}
      </g>

      <!-- Code labels (click targets too; the HTML dot buttons carry a11y) -->
      <g class="locator-labels">
        {layout.map((m) => (
          <text x={m.lx} y={m.ly + 1.02} class="locator-label" text-anchor="middle" data-code={m.p.code}>{m.p.code}</text>
        ))}
      </g>
    </svg>

    <!-- Centroid dots: real HTML buttons overlaid on the SVG (positioned in %
         of the world view, so they track the responsive map). Hidden while
         zoomed — the info chip takes over. -->
    <div class="locator-dots">
      {layout.map((m) => (
        <button
          type="button"
          class="locator-dot"
          data-code={m.p.code}
          title={`${m.p.name} (${m.p.code}) — ${countPhrase(m.p.count)}. Click to zoom to its boundary.`}
          aria-label={`${m.p.name}, ${countPhrase(m.p.count)} — zoom to boundary`}
          style={`left:${(((m.cx - VB_X) / VB_W) * 100).toFixed(3)}%;top:${(((m.cy - VB_Y) / VB_H) * 100).toFixed(3)}%;--dot:${(((2 * m.r) / VB_W) * 100).toFixed(3)}%;`}
        ></button>
      ))}
    </div>

    <!-- Info chip shown while zoomed (HTML overlay, semantic tokens) -->
    <div class="locator-chip" hidden>
      <p class="locator-chip-head">
        <strong class="locator-chip-name"></strong>
        <span class="locator-chip-meta"></span>
      </p>
      <div class="locator-chip-actions">
        <a class="locator-chip-link" href="#"></a>
        <span class="locator-chip-empty" hidden>No datasets yet</span>
        <button type="button" class="locator-chip-reset">&larr; World view</button>
      </div>
    </div>

    <p class="locator-live" role="status" aria-live="polite"></p>

    <script type="application/json" class="locator-payload" is:inline set:html={payloadJson} />
  </div>

  <p class="locator-note" role="note">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" />
    </svg>
    <span>
      Boundaries are the <strong>canonical Living Landscape delineations</strong>, simplified for
      display; each dot marks the landscape centroid.
      {globalCount > 0 && (
        <> Plus {globalCount} global / cross-landscape dataset{globalCount === 1 ? '' : 's'} not shown on the map — <a href={`${base}/catalogue?landscape=GLB`}>browse them in the catalogue</a>.</>
      )}
    </span>
  </p>
</section>

<script>
  // Click-to-zoom for the locator map. Vanilla TS — no runtime dependencies.
  type View = [number, number, number, number]

  interface LandscapeInfo {
    name: string
    country: string | null
    count: number
    bbox: View
  }

  interface Payload {
    base: string
    world: View
    landscapes: Record<string, LandscapeInfo>
  }

  const ZOOM_MS = 600
  const MAX_FILL = 0.7 // boundary occupies at most 70% of the frame

  function initLocator(figure: HTMLElement) {
    const svg = figure.querySelector<SVGSVGElement>('.locator-svg')
    const payloadEl = figure.querySelector('.locator-payload')
    const chip = figure.querySelector<HTMLElement>('.locator-chip')
    const chipName = figure.querySelector<HTMLElement>('.locator-chip-name')
    const chipMeta = figure.querySelector<HTMLElement>('.locator-chip-meta')
    const chipLink = figure.querySelector<HTMLAnchorElement>('.locator-chip-link')
    const chipEmpty = figure.querySelector<HTMLElement>('.locator-chip-empty')
    const chipReset = figure.querySelector<HTMLButtonElement>('.locator-chip-reset')
    const live = figure.querySelector<HTMLElement>('.locator-live')
    if (!svg || !payloadEl?.textContent || !chip || !chipName || !chipMeta || !chipLink || !chipEmpty || !chipReset || !live) return

    const payload = JSON.parse(payloadEl.textContent) as Payload
    const WORLD = payload.world
    const ASPECT = WORLD[2] / WORLD[3]
    const dots = Array.from(figure.querySelectorAll<HTMLButtonElement>('.locator-dot'))
    const outlinePaths = Array.from(svg.querySelectorAll<SVGPathElement>('.locator-outline'))
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

    let selected: string | null = null
    let raf = 0

    const setView = (v: View) => svg.setAttribute('viewBox', v.map((n) => n.toFixed(3)).join(' '))
    const currentView = (): View =>
      (svg.getAttribute('viewBox') ?? WORLD.join(' ')).split(/\s+/).map(Number) as View

    // Letterbox the landscape bbox into the map's fixed aspect ratio:
    // grow both dimensions so the boundary fills at most MAX_FILL of the
    // frame (≈ 21% padding per side), then widen the short axis until the
    // view matches ASPECT (VB_W / VB_H), centred on the bbox centre.
    const viewFor = (bbox: View): View => {
      const cx = (bbox[0] + bbox[2]) / 2
      const cy = (bbox[1] + bbox[3]) / 2
      let w = Math.max(bbox[2] - bbox[0], 0.02) / MAX_FILL
      let h = Math.max(bbox[3] - bbox[1], 0.02) / MAX_FILL
      if (w / h < ASPECT) w = h * ASPECT
      else h = w / ASPECT
      return [cx - w / 2, cy - h / 2, w, h]
    }

    const easeInOutCubic = (t: number) =>
      t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2

    const animateTo = (target: View) => {
      cancelAnimationFrame(raf)
      // Hidden documents never fire rAF — jump straight to the target so the
      // map is never left mid-flight (e.g. user switches tabs mid-zoom).
      if (reduceMotion.matches || document.hidden) {
        setView(target)
        return
      }
      const from = currentView()
      const t0 = performance.now()
      const step = (now: number) => {
        const k = easeInOutCubic(Math.min((now - t0) / ZOOM_MS, 1))
        setView([
          from[0] + (target[0] - from[0]) * k,
          from[1] + (target[1] - from[1]) * k,
          from[2] + (target[2] - from[2]) * k,
          from[3] + (target[3] - from[3]) * k,
        ])
        if (now - t0 < ZOOM_MS) raf = requestAnimationFrame(step)
      }
      raf = requestAnimationFrame(step)
    }

    const countPhrase = (n: number) => (n === 0 ? 'no datasets yet' : `${n} dataset${n === 1 ? '' : 's'}`)

    const zoomTo = (code: string) => {
      const info = payload.landscapes[code]
      if (!info || selected === code) return
      selected = code
      figure.classList.add('is-zoomed')
      for (const p of outlinePaths) p.classList.toggle('is-selected', p.getAttribute('data-code') === code)

      chipName.textContent = info.name
      chipMeta.textContent = `${info.country ? `${info.country} · ` : ''}${countPhrase(info.count)}`
      if (info.count > 0) {
        chipLink.hidden = false
        chipEmpty.hidden = true
        chipLink.href = `${payload.base}/catalogue?landscape=${code}`
        chipLink.textContent = `View ${info.count} dataset${info.count === 1 ? '' : 's'} →`
      } else {
        chipLink.hidden = true
        chipEmpty.hidden = false
      }
      chip.hidden = false
      live.textContent = `Zoomed to ${info.name} — ${countPhrase(info.count)}. Press Escape to return to the world view.`
      animateTo(viewFor(info.bbox))
      // The clicked dot is being hidden; keep focus inside the map.
      chipReset.focus({ preventScroll: true })
    }

    const resetView = () => {
      if (!selected) return
      const code = selected
      selected = null
      chip.hidden = true
      figure.classList.remove('is-zoomed')
      for (const p of outlinePaths) p.classList.remove('is-selected')
      live.textContent = 'World view restored.'
      animateTo(WORLD)
      const dot = dots.find((d) => d.getAttribute('data-code') === code)
      requestAnimationFrame(() => dot?.focus({ preventScroll: true }))
    }

    for (const dot of dots) {
      dot.addEventListener('click', () => {
        const code = dot.getAttribute('data-code')
        if (code) zoomTo(code)
      })
    }

    chipReset.addEventListener('click', resetView)

    // Delegated SVG clicks: outlines/labels zoom in; while zoomed, anything
    // that is not the selected boundary (sea, land, faded marks) zooms out.
    svg.addEventListener('click', (e) => {
      const hit = (e.target as Element).closest('[data-code]')
      const code = hit?.getAttribute('data-code') ?? null
      if (!selected) {
        if (code) zoomTo(code)
      } else if (code !== selected) {
        resetView()
      }
    })

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && selected) resetView()
    })
  }

  document.querySelectorAll<HTMLElement>('.locator-figure').forEach(initLocator)
</script>

<style>
  .locator {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 14px);
    padding: 1.5rem;
    margin: 0 0 1.75rem;
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: 1.25rem 1.75rem;
    align-items: center;
  }
  .locator-head { max-width: none; align-self: center; }
  .locator-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.25rem;
    color: var(--color-text);
    margin: 0 0 0.35rem;
  }
  .locator-sub {
    font-size: 0.92rem;
    color: var(--color-muted);
    margin: 0 0 1rem;
  }
  .locator-figure { position: relative; margin: 0; }
  .locator-svg {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    border: 1px solid #D4E6E7;
    background: #EEF5F5;
  }

  /* Boundaries: hairline strokes at any zoom via non-scaling-stroke
     (stroke-width is in screen px, not viewBox units). */
  .locator-outline {
    stroke-width: 1;
    cursor: pointer;
    transition: opacity 0.3s ease, fill-opacity 0.3s ease;
  }
  .locator-outline.is-selected {
    fill-opacity: 0.4;
    stroke-width: 1.6;
    cursor: default;
  }

  .locator-label {
    font-size: 2.9px;
    font-weight: 700;
    letter-spacing: 0.02px;
    fill: #14323C;
    paint-order: stroke;
    stroke: #FFFFFF;
    stroke-width: 0.7px;
    stroke-linejoin: round;
    cursor: pointer;
    user-select: none;
  }

  /* ── Centroid dot buttons (HTML overlay) ─────────────────────────── */
  .locator-dots {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .locator-dot {
    position: absolute;
    transform: translate(-50%, -50%);
    width: max(11px, var(--dot));
    aspect-ratio: 1;
    padding: 0;
    border-radius: 50%;
    background: var(--mosaic-teal);
    border: 1px solid #FFFFFF;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.92);
    cursor: pointer;
    pointer-events: auto;
  }
  .locator-dot:hover {
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.92), 0 0 0 3.5px var(--mosaic-terracotta);
  }
  .locator-dot:focus-visible {
    outline: 2px solid var(--mosaic-teal);
    outline-offset: 3px;
  }

  /* ── Zoomed state: only the selected boundary + land context remain ── */
  .locator-graticule,
  .locator-leaders,
  .locator-labels {
    transition: opacity 0.3s ease;
  }
  .is-zoomed .locator-graticule,
  .is-zoomed .locator-leaders,
  .is-zoomed .locator-labels {
    opacity: 0;
    pointer-events: none;
  }
  .is-zoomed .locator-dots {
    opacity: 0;
    visibility: hidden;
  }
  .is-zoomed .locator-outline:not(.is-selected) {
    opacity: 0;
    pointer-events: none;
  }

  /* ── Info chip (HTML overlay, semantic tokens → dark-mode aware) ──── */
  .locator-chip {
    --chip-link: var(--mosaic-teal);
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 2;
    max-width: min(78%, 320px);
    display: grid;
    gap: 0.4rem;
    padding: 0.6rem 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    font-size: 0.85rem;
    line-height: 1.35;
