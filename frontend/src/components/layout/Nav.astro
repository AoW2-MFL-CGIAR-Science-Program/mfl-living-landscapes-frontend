---
import Icon from '../ui/Icon.astro'

const base = import.meta.env.BASE_URL
const currentPath = Astro.url.pathname

const navLinks = [
  { href: `${base}/`, label: 'Home', exact: true },
  { href: `${base}/catalogue`, label: 'Catalogue' },
  { href: `${base}/landscapes`, label: 'Landscapes' },
  { href: `${base}/contribute`, label: 'Contribute' },
  { href: `${base}/about`, label: 'About' },
  { href: `${base}/contact`, label: 'Contact' },
]

// Home must match exactly, otherwise it would light up on every page
// (every path starts with the base path).
function isActive(href: string, exact = false) {
  const path = currentPath.replace(/\/$/, '') || '/'
  const target = href.replace(/\/$/, '') || '/'
  return exact ? path === target : path === target || path.startsWith(target + '/')
}
---

<!-- Skip-to-content link (renderizado aquí, posicionado por CSS en BaseLayout) -->
<a href="#main-content" class="skip-link">Skip to main content</a>

<!-- Desktop nav -->
<nav aria-label="Main navigation" class="main-nav">
  <ul class="nav-list">
    {navLinks.map(link => (
      <li>
        <a
          href={link.href}
          class="nav-link"
          aria-current={isActive(link.href, link.exact) ? 'page' : undefined}
        >{link.label}</a>
      </li>
    ))}
  </ul>
  <button
    type="button"
    class="theme-toggle js-theme-toggle"
    aria-label="Switch to dark theme"
    aria-pressed="false"
  >
    <Icon name="sun" size={20} aria-hidden="true" />
    <Icon name="moon" size={20} aria-hidden="true" />
  </button>
</nav>

<!-- Mobile hamburger -->
<button
  type="button"
  class="hamburger"
  aria-label="Open navigation menu"
  aria-expanded="false"
  aria-controls="mobile-menu"
  id="hamburger-btn"
>
  <svg aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none">
    <path class="hamburger-open" d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path class="hamburger-close" d="M6 6l12 12M6 18L18 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none"/>
  </svg>
</button>

<!-- Mobile menu panel -->
<nav
  class="mobile-menu"
  id="mobile-menu"
  aria-label="Mobile navigation"
  hidden
>
  <ul class="mobile-nav-list">
    {navLinks.map(link => (
      <li>
        <a
          href={link.href}
          class="mobile-nav-link"
          aria-current={isActive(link.href, link.exact) ? 'page' : undefined}
        >{link.label}</a>
      </li>
    ))}
  </ul>
  <button
    type="button"
    class="theme-toggle theme-toggle-mobile js-theme-toggle"
    aria-label="Switch to dark theme"
    aria-pressed="false"
  >
    <Icon name="sun" size={20} aria-hidden="true" />
    <Icon name="moon" size={20} aria-hidden="true" />
    <span class="theme-toggle-label">Switch theme</span>
  </button>
</nav>

<style>
  /* ── Skip link ─────────────────────────────────────── */
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    background: var(--color-white);
    color: var(--color-green-dark);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: var(--text-sm);
    z-index: 9999;
    text-decoration: none;
    transition: top 0.1s;
  }
  .skip-link:focus {
    top: var(--space-2);
  }

  /* ── Desktop nav ────────────────────────────────────── */
  .main-nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* ── Theme toggle ───────────────────────────────────── */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 44px;
    min-height: 44px;
    padding: var(--space-2);
    background: none;
    border: none;
    border-radius: var(--radius-md);
    color: rgba(255, 255, 255, 0.82);
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
  }

  .theme-toggle:hover {
    color: var(--mosaic-light-teal);
    background-color: rgba(255, 255, 255, 0.1);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--mosaic-teal);
    outline-offset: 2px;
  }

  /* Icon swap: show sun in light theme, moon in dark theme.
     Rules are global because [data-theme] lives on <html> and the
     <svg> glyphs are rendered by the Icon child component. */
  :global(.theme-toggle .icon-moon) { display: none; }
  :global([data-theme="dark"] .theme-toggle .icon-sun) { display: none; }
  :global([data-theme="dark"] .theme-toggle .icon-moon) { display: block; }

  .theme-toggle-label { display: none; }

  .theme-toggle-mobile {
    width: 100%;
    justify-content: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-6);
    border-radius: 0;
    color: var(--color-gray-700);
    font-size: var(--text-base);
    font-weight: 500;
  }

  .theme-toggle-mobile .theme-toggle-label { display: inline; }

  .theme-toggle-mobile:hover {
    background-color: var(--color-gray-50);
    color: var(--color-cgiar-teal);
  }

  .nav-list {
    list-style: none;
    display: flex;
    gap: var(--space-6);
    align-items: center;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2) 0;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s, color 0.15s;
    min-height: 44px;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--mosaic-light-teal);
    outline: none;
  }

  .nav-link[aria-current="page"] {
    color: var(--color-white);
    border-bottom-color: var(--mosaic-light-teal);
    font-weight: 600;
  }

  /* ── Hamburger (hidden on desktop) ─────────────────── */
  .hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-white);
    padding: var(--space-2);
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
  }

  .hamburger:focus-visible {
    outline: 2px solid var(--color-cgiar-teal);
    outline-offset: 2px;
  }

  /* ── Mobile menu panel ──────────────────────────────── */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-white);
    z-index: 200;
    border-top: 1px solid var(--color-gray-200);
    border-bottom: 2px solid var(--color-cgiar-teal);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    padding: var(--space-4) 0 var(--space-6);
  }

  .mobile-menu[hidden] { display: none; }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-nav-link {
    display: block;
    padding: var(--space-3) var(--space-6);
    color: var(--color-gray-700);
    text-decoration: none;
    font-size: var(--text-base);
    font-weight: 500;
    min-height: 44px;
    display: flex;
    align-items: center;
    transition: background-color 0.1s, color 0.1s;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    background-color: var(--color-gray-50);
    color: var(--color-cgiar-teal);
    outline: none;
  }

  .mobile-nav-link[aria-current="page"] {
    color: var(--color-gray-900);
    font-weight: 600;
    border-left: 3px solid var(--color-cgiar-teal);
    padding-left: calc(var(--space-6) - 3px);
  }

  /* ── Responsive: show hamburger, hide desktop nav ──── */
  @media (max-width: 767px) {
    .main-nav { display: none; }
    .hamburger { display: flex; }
  }
</style>

<script>
  // Hamburger: toggle mobile menu
  const hamburger = document.getElementById('hamburger-btn')
  const mobileMenu = document.getElementById('mobile-menu')

  if (hamburger && mobileMenu) {
    hamburger.addEventListener('click', () => {
      const open = hamburger.getAttribute('aria-expanded') === 'true'
      hamburger.setAttribute('aria-expanded', String(!open))
      hamburger.setAttribute('aria-label', open ? 'Open navigation menu' : 'Close navigation menu')
      mobileMenu.hidden = open
      // swap icon paths
      const openPaths = hamburger.querySelectorAll('.hamburger-open')
      const closePaths = hamburger.querySelectorAll('.hamburger-close')
      openPaths.forEach(p => ((p as HTMLElement).style.display = open ? '' : 'none'))
      closePaths.forEach(p => ((p as HTMLElement).style.display = open ? 'none' : ''))
    })

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && hamburger.getAttribute('aria-expanded') === 'true') {
        hamburger.setAttribute('aria-expanded', 'false')
        mobileMenu.hidden = true
        hamburger.focus()
      }
    })
  }
</script>
