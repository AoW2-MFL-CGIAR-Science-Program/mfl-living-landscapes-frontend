---
import Nav from './Nav.astro'
const base = import.meta.env.BASE_URL
---

<header class="site-header">
  <div class="container site-header-inner">
    <a href={base} class="site-logo" aria-label="MFL Living Landscapes Data Hub — home">
      <img
        src={`${base}/cgiar-logo.svg`}
        alt="CGIAR"
        class="site-logo-cgiar"
        width="70"
        height="26"
      />
      <span class="site-logo-divider" aria-hidden="true"></span>
      <div class="site-logo-text">
        <span class="site-logo-name">MFL Living Landscapes</span>
        <span class="site-logo-tagline">Geospatial Data Hub</span>
      </div>
    </a>

    <Nav />
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-white);
    border-bottom: 3px solid var(--color-cgiar-teal);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.06);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    gap: var(--space-4);
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-gray-900);
    flex-shrink: 0;
  }

  .site-logo:focus-visible {
    outline: 2px solid var(--color-cgiar-teal);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .site-logo-cgiar {
    height: 28px;
    width: auto;
    flex-shrink: 0;
  }

  .site-logo-divider {
    display: block;
    width: 1px;
    height: 26px;
    background-color: var(--color-gray-200);
    flex-shrink: 0;
  }

  .site-logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    gap: 1px;
  }

  .site-logo-name {
    font-family: var(--font-title);
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-gray-900);
  }

  .site-logo-tagline {
    font-size: 0.65rem;
    color: var(--color-gray-400);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    font-weight: 500;
  }

  @media (max-width: 480px) {
    .site-logo-text { display: none; }
    .site-logo-divider { display: none; }
  }
</style>
