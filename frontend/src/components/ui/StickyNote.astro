---
interface Props {
  tint?: 'amber' | 'teal' | 'terracotta'
  rotate?: number
}

const { tint = 'amber', rotate = -3 } = Astro.props
---

<div class="sticky-note" data-tint={tint} style={`--rotate:${rotate}deg`}>
  <span class="sticky-note-tape" aria-hidden="true"></span>
  <div class="sticky-note-body">
    <slot />
  </div>
</div>

<style>
  .sticky-note {
    position: relative;
    display: inline-block;
    max-width: 220px;
    padding: var(--space-4) var(--space-4) var(--space-3);
    transform: rotate(var(--rotate, -3deg));
    border-radius: 3px;
    box-shadow: var(--shadow-md);
    font-family: 'Bradley Hand', 'Segoe Script', 'Comic Sans MS', cursive;
    font-size: var(--text-lg);
    line-height: 1.35;
    color: var(--mosaic-ink);

    --note-bg: #FBE6C9;
  }
  .sticky-note[data-tint='teal']       { --note-bg: #CFE9EE; }
  .sticky-note[data-tint='terracotta'] { --note-bg: #F2D9CE; }

  .sticky-note { background-color: var(--note-bg); }

  .sticky-note-tape {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%) rotate(-2deg);
    width: 64px;
    height: 18px;
    background-color: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(0, 0, 0, 0.05);
  }
</style>
