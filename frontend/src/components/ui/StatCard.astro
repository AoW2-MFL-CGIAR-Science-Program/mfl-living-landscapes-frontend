---
import Icon from './Icon.astro'

interface Props {
  icon: string
  value: string | number
  label: string
  tint?: 'teal' | 'amber' | 'terracotta' | 'light-teal'
}

const { icon, value, label, tint = 'teal' } = Astro.props
---

<div class="stat-card" data-tint={tint}>
  <span class="stat-card-icon" aria-hidden="true">
    <Icon name={icon as any} size={22} />
  </span>
  <div class="stat-card-text">
    <span class="stat-card-value">{value}</span>
    <span class="stat-card-label">{label}</span>
  </div>
</div>

<style>
  .stat-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);

    --chip-bg: var(--tint-teal-bg);
    --chip-fg: var(--tint-teal-fg);
  }
  .stat-card[data-tint='amber']       { --chip-bg: var(--tint-amber-bg);       --chip-fg: var(--tint-amber-fg); }
  .stat-card[data-tint='terracotta']  { --chip-bg: var(--tint-terracotta-bg);  --chip-fg: var(--tint-terracotta-fg); }
  .stat-card[data-tint='light-teal']  { --chip-bg: var(--tint-light-teal-bg);  --chip-fg: var(--tint-light-teal-fg); }

  .stat-card-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background-color: var(--chip-bg);
    color: var(--chip-fg);
  }

  .stat-card-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .stat-card-value {
    font-family: var(--font-title);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--mosaic-teal);
  }

  .stat-card-label {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-top: 2px;
  }
</style>
