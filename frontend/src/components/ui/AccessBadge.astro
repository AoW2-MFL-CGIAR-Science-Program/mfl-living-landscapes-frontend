---
import type { AccessLevel } from '../../utils/types'

interface Props {
  access: AccessLevel | null
}

const { access } = Astro.props

const classMap: Record<AccessLevel, string> = {
  'Open': 'badge-open',
  'Internal': 'badge-internal',
  'Restricted': 'badge-restricted',
}

const label = access ?? 'Access not specified'
const cls = access ? (classMap[access] ?? 'badge-internal') : 'badge-internal'
---

<span class={`badge ${cls}`}>{label}</span>
