---
import type { ReadinessStatus } from '../../utils/types'

interface Props {
  status: ReadinessStatus
}

const { status } = Astro.props

const classMap: Record<ReadinessStatus, string> = {
  'Raw': 'badge-raw',
  'Processed': 'badge-processed',
  'Validated': 'badge-validated',
}
---

<span class={`badge ${classMap[status] ?? 'badge-raw'}`}>{status}</span>
