---
import Icon from './Icon.astro'

interface Props {
  variant?: 'info-amber' | 'note-teal'
  icon?: string
  title?: string
}

const { variant = 'note-teal', icon, title } = Astro.props
const hasArt = Astro.slots.has('art')
---

<div class:list={['info-callout', `info-callout--${variant}`]}>
  {icon && (
    <span class="info-callout-icon" aria-hidden="true">
      <Icon name={icon as any} size={22} />
    </span>
  )}
  <div class="info-callout-body">
    {title && <p class="info-callout-title">{title}</p>}
    <div class="info-callout-text"><slot /></div>
  </div>
  {hasArt && (
    <div class="info-callout-art" aria-hidden="true">
      <slot name="art" />
    </div>
  )}
</div>

<style>
  .info-callout {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    line-height: 1.6;
  }

  .info-callout--info-amber {
    background-color: #FBF1DF;
    border: 1px solid #E9D2A8;
    color: var(--mosaic-ink);
  }
  .info-callout--info-amber .info-callout-icon { color: var(--mosaic-amber); }

  .info-callout--note-teal {
    background-color: var(--mosaic-light-teal);
    color: var(--mosaic-ink);
    gap: var(--space-4);
    padding: var(--space-6);
  }
  .info-callout--note-teal .info-callout-icon { color: var(--mosaic-teal); }

  .info-callout-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .info-callout-body { min-width: 0; flex: 1; }

  .info-callout-title {
    margin: 0 0 var(--space-1);
    font-weight: 700;
  }

  .info-callout-text { font-size: var(--text-sm); }
  .info-callout--note-teal .info-callout-text { font-size: var(--text-base); }

  .info-callout-art {
    flex-shrink: 0;
    width: 120px;
    align-self: center;
  }
  .info-callout-art :global(img),
  .info-callout-art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 640px) {
    .info-callout-art { display: none; }
  }
</style>
