---
interface Props {
  title: string
  subtitle?: string
}

const { title, subtitle } = Astro.props
---

<section class="page-hero">
  <div class="container">
    <h1 class="page-hero-title">{title}</h1>
    {subtitle && <p class="page-hero-subtitle">{subtitle}</p>}
  </div>
</section>

<style>
  .page-hero {
    background-color: var(--mosaic-teal);
    color: var(--color-white);
    padding: var(--space-12) 0;
  }

  .page-hero-title {
    color: var(--color-white);
    margin-bottom: var(--space-3);
  }

  /* Light Teal (#D6EEF2) on Ocean Teal (#0D5C6B) — contrast ~7:1 */
  .page-hero-subtitle {
    color: var(--mosaic-light-teal);
    font-size: var(--text-lg);
    max-width: 640px;
    line-height: 1.6;
    margin: 0;
  }
</style>
