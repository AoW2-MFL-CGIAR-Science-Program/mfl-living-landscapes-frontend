---
interface Props {
  title: string
  subtitle?: string
}

const { title, subtitle } = Astro.props
---

<section class="page-hero">
  <!-- Topographic contour pattern (decorative), shared with Home/Catalogue heroes -->
  <div class="page-hero-topo" aria-hidden="true">
    <svg width="100%" height="100%" viewBox="0 0 1440 320" preserveAspectRatio="xMidYMid slice" fill="none">
      <g stroke="#D6EEF2" stroke-width="1.2" fill="none">
        <path d="M-100 280 Q260 240 540 268 T1080 250 T1600 282" opacity="0.12"/>
        <path d="M-100 230 Q300 188 580 216 T1120 198 T1600 230" opacity="0.11"/>
        <path d="M-100 180 Q340 136 620 164 T1160 146 T1600 178" opacity="0.10"/>
        <path d="M-100 130 Q380 86 660 114 T1200 96 T1600 128" opacity="0.08"/>
        <path d="M-100 80 Q420 36 700 64 T1240 46 T1600 78" opacity="0.06"/>
      </g>
    </svg>
  </div>

  <div class="container page-hero-inner">
    <h1 class="page-hero-title">{title}</h1>
    {subtitle && <p class="page-hero-subtitle">{subtitle}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    background-color: var(--mosaic-teal);
    background-image: linear-gradient(120deg, #1C2B3A 0%, #0D5C6B 58%, #0A4753 100%);
    color: var(--color-white);
    padding: var(--space-12) 0;
    overflow: hidden;
  }

  .page-hero-topo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .page-hero-topo svg {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
  }

  .page-hero-inner {
    position: relative;
    z-index: 1;
  }

  .page-hero-title {
    color: var(--color-white);
    margin-bottom: var(--space-3);
  }

  /* Light Teal (#D6EEF2) on Ocean Teal — contrast ~7:1 */
  .page-hero-subtitle {
    color: var(--mosaic-light-teal);
    font-size: var(--text-lg);
    max-width: 640px;
    line-height: 1.6;
    margin: 0;
  }
</style>
