---
import Icon from './Icon.astro'

interface Props {
  icon: string
  label: string
  caption?: string
  tint?: 'teal' | 'amber' | 'terracotta' | 'light-teal'
  align?: 'left' | 'center'
}

const { icon, label, caption, tint = 'teal', align = 'left' } = Astro.props
---

<div class:list={['icon-chip', `icon-chip--${align}`]} data-tint={tint}>
  <span class="icon-chip-circle" aria-hidden="true">
    <Icon name={icon as any} size={22} />
  </span>
  <div class="icon-chip-text">
    <p class="icon-chip-label">{label}</p>
    {caption && <p class="icon-chip-caption">{caption}</p>}
  </div>
</div>

<style>
  .icon-chip {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;

    --chip-bg: var(--tint-teal-bg);
    --chip-fg: var(--tint-teal-fg);
  }
  .icon-chip[data-tint='amber']       { --chip-bg: var(--tint-amber-bg);       --chip-fg: var(--tint-amber-fg); }
  .icon-chip[data-tint='terracotta']  { --chip-bg: var(--tint-terracotta-bg);  --chip-fg: var(--tint-terracotta-fg); }
  .icon-chip[data-tint='light-teal']  { --chip-bg: var(--tint-light-teal-bg);  --chip-fg: var(--tint-light-teal-fg); }

  .icon-chip--center {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .icon-chip-circle {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background-color: var(--chip-bg);
    color: var(--chip-fg);
  }

  .icon-chip-text { min-width: 0; }

  .icon-chip-label {
    margin: 0;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
  }

  .icon-chip-caption {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.5;
  }
</style>
