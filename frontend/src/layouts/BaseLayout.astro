---
import '../styles/global.css'
import '../styles/badges.css'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'

interface Props {
  title: string
  description?: string
  ogImage?: string
}

const {
  title,
  description = 'MOSAIC — the shared spatial intelligence network for the CGIAR Multifunctional Landscapes Science Programme (AoW2). Find, trust, and combine geospatial data across the Living Landscapes.',
  ogImage = '/mfl-living-landscapes-frontend/og-image.png',
} = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const pageTitle = title === 'Home'
  ? 'MOSAIC — CGIAR MFL Science Programme'
  : `${title} | MOSAIC`
const base = import.meta.env.BASE_URL
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Set the colour theme before first paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('mosaic-theme')
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
          }
          if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark')
        } catch (e) {}
      })()
    </script>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalURL} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:site_name" content="MOSAIC — CGIAR MFL Science Programme" />
    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <!-- Theme toggle wiring (runs once, shared by every .js-theme-toggle button). -->
    <script is:inline>
      (function () {
        var root = document.documentElement
        var btns = document.querySelectorAll('.js-theme-toggle')

        function syncButtons(isDark) {
          for (var i = 0; i < btns.length; i++) {
            btns[i].setAttribute('aria-pressed', String(isDark))
            btns[i].setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme')
          }
        }

        syncButtons(root.getAttribute('data-theme') === 'dark')

        for (var j = 0; j < btns.length; j++) {
          btns[j].addEventListener('click', function () {
            var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
            if (next === 'dark') root.setAttribute('data-theme', 'dark')
            else root.removeAttribute('data-theme')
            try { localStorage.setItem('mosaic-theme', next) } catch (e) {}
            syncButtons(next === 'dark')
          })
        }
      })()
    </script>
  </body>
</html>
