---
import BaseLayout from '../layouts/BaseLayout.astro'
import StatusBadge from '../components/ui/StatusBadge.astro'
import AccessBadge from '../components/ui/AccessBadge.astro'
import ContentCard from '../components/ui/ContentCard.astro'
import Icon from '../components/ui/Icon.astro'
import datasets from '../../data/datasets.json'

const base = import.meta.env.BASE_URL
const totalDatasets = datasets.length
const countries = [...new Set(datasets.map((d) => d.country))].length
const landscapes = [...new Set(datasets.map((d) => d.living_landscape))].length
const featured = datasets.slice(0, 3)
---

<BaseLayout title="Home">

  <!-- ── Hero ──────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <p class="hero-eyebrow">Open geospatial data for living landscapes</p>
        <h1 class="hero-headline">Find and share geospatial data for living landscapes</h1>
        <p class="hero-sub">
          MOSAIC connects datasets, institutions and local knowledge to make landscape
          information easier to discover, compare and use.
        </p>
        <p class="hero-support">
          Use MOSAIC to explore trusted geospatial datasets, understand where they apply, and
          contribute data from your institution, project or landscape initiative.
        </p>
        <div class="hero-actions">
          <a href={`${base}/catalogue`} class="btn btn-hero-primary">
            <Icon name="search" size={18} aria-hidden="true" /> Explore datasets
          </a>
          <a href={`${base}/contribute`} class="btn btn-hero-ghost">
            <Icon name="database" size={18} aria-hidden="true" /> Contribute a dataset
          </a>
        </div>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <img src={`${base}/illustrations/hero-home.jpg`} alt="" />
    </div>
  </section>

  <!-- ── Stats bar (floating card) ─────────────────────────────────── -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-card">
        <div class="stat-item">
          <span class="stat-icon" data-tint="teal" aria-hidden="true"><Icon name="database" size={24} /></span>
          <span class="stat-text">
            <span class="stat-number">{totalDatasets}</span>
            <span class="stat-label">Datasets catalogued</span>
          </span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <span class="stat-icon" data-tint="green" aria-hidden="true"><Icon name="mountains" size={24} /></span>
          <span class="stat-text">
            <span class="stat-number">{landscapes}</span>
            <span class="stat-label">Landscapes with data</span>
          </span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <span class="stat-icon" data-tint="amber" aria-hidden="true"><Icon name="globe" size={24} /></span>
          <span class="stat-text">
            <span class="stat-number">{countries}</span>
            <span class="stat-label">Countries with data</span>
          </span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <span class="stat-icon" data-tint="teal" aria-hidden="true"><Icon name="building" size={24} /></span>
          <span class="stat-text">
            <span class="stat-number">10</span>
            <span class="stat-label">CGIAR centres</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Entry points ──────────────────────────────────────────────── -->
  <section class="section-subtle">
    <div class="container">
      <div class="section-head">
        <p class="section-eyebrow">Three ways in</p>
        <h2 class="section-title-center">Choose what you need</h2>
        <svg class="section-wavy" width="72" height="9" viewBox="0 0 64 8" fill="none" aria-hidden="true">
          <path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="home-entry">
        <ContentCard icon="search" title="Find data" href={`${base}/catalogue`} tint="teal" arrow>
          Search datasets by place, theme, source or readiness status.
        </ContentCard>
        <ContentCard icon="upload" title="Share data" href={`${base}/contribute`} tint="amber" arrow>
          Register a dataset so others can discover, cite or request access to it.
        </ContentCard>
        <ContentCard icon="map-pin" title="Use data for decisions" href={`${base}/landscapes`} tint="terracotta" arrow>
          Explore landscape evidence for planning, restoration, monitoring and research.
        </ContentCard>
      </div>
    </div>
  </section>

  <!-- ── Who is MOSAIC for? ────────────────────────────────────────── -->
  <section class="section-white">
    <div class="container">
      <div class="section-head">
        <p class="section-eyebrow section-eyebrow--amber">Open to all</p>
        <h2 class="section-title-center">Who is MOSAIC for?</h2>
        <svg class="section-wavy" width="72" height="9" viewBox="0 0 64 8" fill="none" aria-hidden="true">
          <path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
        </svg>
      </div>
      <ul class="who-grid">
        <li class="who-item"><span class="who-ico" data-tint="teal" aria-hidden="true"><Icon name="search" size={20} /></span><span><strong>Researchers</strong> looking for landscape datasets</span></li>
        <li class="who-item"><span class="who-ico" data-tint="amber" aria-hidden="true"><Icon name="upload" size={20} /></span><span><strong>Institutions</strong> sharing geospatial evidence</span></li>
        <li class="who-item"><span class="who-ico" data-tint="terracotta" aria-hidden="true"><Icon name="map-pin" size={20} /></span><span><strong>Landscape teams</strong> coordinating data across places</span></li>
        <li class="who-item"><span class="who-ico" data-tint="teal" aria-hidden="true"><Icon name="sparkles" size={20} /></span><span><strong>Decision-makers</strong> comparing environmental and social information</span></li>
        <li class="who-item"><span class="who-ico" data-tint="amber" aria-hidden="true"><Icon name="database" size={20} /></span><span><strong>Data stewards</strong> improving discoverability and reuse</span></li>
        <li class="who-item"><span class="who-ico" data-tint="terracotta" aria-hidden="true"><Icon name="users" size={20} /></span><span><strong>Funders and partners</strong> tracking evidence across initiatives</span></li>
      </ul>
    </div>
  </section>

  <!-- ── Featured datasets ─────────────────────────────────────────── -->
  <section class="section-subtle">
    <div class="container">
      <div class="section-header">
        <div class="section-header-text">
          <p class="section-eyebrow section-eyebrow--amber">Explore data</p>
          <h2>Featured datasets</h2>
          <p class="section-subtitle">Recently added and validated datasets from across the network.</p>
        </div>
        <a href={`${base}/catalogue`} class="section-link">Browse all {totalDatasets} datasets &rarr;</a>
      </div>
      <div class="cards-grid">
        {featured.map((d) => (
          <article class="dataset-card-new">
            <div class="dataset-card-badges">
              <StatusBadge status={d.readiness_status} />
              <AccessBadge access={d.access_level} />
            </div>
            <h3 class="dataset-card-title">{d.title}</h3>
            <dl class="dataset-card-meta">
              <div><dt>Country</dt><dd>{d.country}</dd></div>
              <div><dt>Theme</dt><dd>{d.mfl_theme}</dd></div>
            </dl>
            <a href={`${base}/catalogue/${d.id}`} class="dataset-card-link">View details &rarr;</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Closing CTA — grow the network ────────────────────────────── -->
  <section class="grow-cta">
    <div class="container">
      <div class="grow-card">
        <div class="grow-art" aria-hidden="true">
          <img src={`${base}/illustrations/seedling.png`} alt="" />
        </div>
        <div class="grow-main">
          <h2 class="grow-title">Help grow the MOSAIC network</h2>
          <p class="grow-body">Your dataset could help researchers, landscape teams and decision-makers across multiple countries.</p>
          <ul class="grow-features">
            <li><span class="grow-feat-icon" aria-hidden="true"><Icon name="users" size={18} /></span><span>Strengthen collaboration</span></li>
            <li><span class="grow-feat-icon" aria-hidden="true"><Icon name="database" size={18} /></span><span>Increase data discoverability</span></li>
            <li><span class="grow-feat-icon" aria-hidden="true"><Icon name="sparkles" size={18} /></span><span>Drive better decisions</span></li>
          </ul>
        </div>
        <a class="grow-btn" href={`${base}/contribute`}>
          Contribute a dataset
          <Icon name="arrow-right" size={18} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero (light) ──────────────────────────────────────────── */
  .hero {
    position: relative;
    background-color: var(--mosaic-sand);
    color: var(--mosaic-ink);
    padding: 4.5rem 0 6.5rem;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
  }
  .hero-content { max-width: 540px; }

  /* Full-bleed art anchored to the right edge of the viewport */
  .hero-art {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 58%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    pointer-events: none;
    z-index: 1;
  }
  .hero-art img {
    display: block;
    width: 100%;
    height: auto;
    /* Soft blend of the image's left edge into the sand background */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 16%);
    mask-image: linear-gradient(to right, transparent 0%, #000 16%);
  }

  .hero-eyebrow {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mosaic-amber);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }
  .hero-headline {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--mosaic-ink);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }
  .hero-sub {
    font-size: var(--text-lg);
    /* Fixed grey (not a theming token) — this hero is always light in both
       themes, so the subtitle must stay dark-on-sand and never invert. */
    color: #4B5563;
    line-height: 1.7;
    max-width: 470px;
    margin-bottom: var(--space-4);
  }
  .hero-support {
    font-size: var(--text-base);
    color: #5B6B72;
    line-height: 1.65;
    max-width: 470px;
    margin: 0 0 var(--space-8);
  }
  .hero-actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .hero-actions .btn { display: inline-flex; align-items: center; gap: var(--space-2); }

  .btn-hero-primary {
    background-color: var(--mosaic-amber);
    color: var(--color-white);
    border-color: var(--mosaic-amber);
    font-weight: 600;
    padding: var(--space-3) var(--space-6);
  }
  .btn-hero-primary:hover { background-color: #b06d12; border-color: #b06d12; color: var(--color-white); }
  .btn-hero-ghost {
    background-color: var(--color-surface);
    color: var(--mosaic-teal);
    border: 2px solid var(--mosaic-teal);
    font-weight: 600;
    padding: var(--space-3) var(--space-6);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-base);
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
    cursor: pointer;
  }
  .btn-hero-ghost:hover { background-color: var(--mosaic-teal); color: var(--color-white); }

  /* ── Stats (floating card) ─────────────────────────────────── */
  .stats-section {
    background-color: var(--color-bg);
    padding: 0 0 var(--space-16);
  }
  .stats-card {
    position: relative;
    z-index: 5;
    margin-top: -3.5rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-8);
  }
  .stat-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex: 1 1 0;
    min-width: 0;
  }
  .stat-icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
  }
  .stat-icon[data-tint="teal"]  { background-color: var(--mosaic-teal); }
  .stat-icon[data-tint="green"] { background-color: #6F8F5F; }
  .stat-icon[data-tint="amber"] { background-color: var(--mosaic-amber); }
  .stat-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .stat-number {
    font-family: var(--font-title);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .stat-label { font-size: var(--text-sm); color: var(--color-muted); font-weight: 400; }
  .stat-divider { width: 1px; align-self: stretch; background-color: var(--color-border); flex-shrink: 0; margin: var(--space-1) 0; }

  /* ── Sections ──────────────────────────────────────────────── */
  .section-white { background-color: var(--color-bg); padding: var(--space-16) 0; }
  .section-subtle { background-color: var(--color-gray-50); padding: var(--space-16) 0; }
  .section-title-center { text-align: center; margin-bottom: var(--space-12); }

  /* Centred section head: eyebrow + title + wavy underline */
  .section-head { text-align: center; margin-bottom: var(--space-12); }
  .section-head .section-title-center { margin-bottom: var(--space-2); }
  .section-eyebrow {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6F8F5F;
  }
  .section-wavy { display: inline-block; color: var(--mosaic-teal); }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-8);
    gap: var(--space-4);
  }
  .section-header h2 { margin: 0; }
  .section-header-text { display: flex; flex-direction: column; }
  .section-header .section-eyebrow { margin-bottom: var(--space-2); }
  .section-eyebrow--amber { color: var(--mosaic-amber); }
  .section-subtitle {
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
    font-size: var(--text-base);
    max-width: 60ch;
  }
  .section-link { font-size: var(--text-sm); font-weight: 600; color: var(--mosaic-teal); text-decoration: none; white-space: nowrap; }

  .home-entry { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }

  /* ── "Who is MOSAIC for?" audience grid ─────────────────────── */
  .who-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6) var(--space-8);
  }
  .who-item {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    color: var(--color-text);
    line-height: 1.45;
  }
  .who-item strong { font-weight: 700; }
  .who-ico {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .who-ico[data-tint="teal"]      { background: #D6EEF2; color: var(--mosaic-teal); }
  .who-ico[data-tint="amber"]     { background: #F6E6CE; color: var(--mosaic-amber); }
  .who-ico[data-tint="terracotta"]{ background: #F3DED6; color: var(--mosaic-terracotta); }
  @media (max-width: 900px) { .who-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .who-grid { grid-template-columns: 1fr; } }

  /* ── "Find your way in" action cards ───────────────────────────
     Rounded card with a topographic contour texture rising from the
     bottom-right corner, one hue per card (teal / amber / terracotta)
     to follow the MOSAIC graphic line. Scoped to .home-entry so other
     ContentCard uses are untouched. */
  .home-entry :global(.content-card) {
    --contour: 8, 90, 117;            /* teal (default) */
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 24px;
    box-shadow: 0 14px 35px rgba(8, 90, 117, 0.08);
  }
  .home-entry :global(.content-card[data-tint="amber"])      { --contour: 201, 125, 27; }
  .home-entry :global(.content-card[data-tint="terracotta"]) { --contour: 181, 77, 47; }

  /* Keep the card content above the contour layer */
  .home-entry :global(.content-card) > * { position: relative; z-index: 1; }

  /* Contour texture lives on a masked layer so it stays in the bottom-right
     corner and fades out before it reaches the title/body. */
  .home-entry :global(.content-card)::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(ellipse at bottom right, rgba(var(--contour), 0.12), transparent 50%),
      repeating-radial-gradient(
        ellipse at bottom right,
        rgba(var(--contour), 0.14) 0,
        rgba(var(--contour), 0.14) 1px,
        transparent 1px,
        transparent 14px
      );
    -webkit-mask-image: radial-gradient(ellipse 85% 85% at bottom right, #000 0%, transparent 58%);
    mask-image: radial-gradient(ellipse 85% 85% at bottom right, #000 0%, transparent 58%);
  }

  .home-entry :global(.content-card--link:hover) {
    box-shadow: 0 20px 45px rgba(8, 90, 117, 0.16);
  }

  /* ── Dataset cards ─────────────────────────────────────────── */
  .cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-6); }
  .dataset-card-new {
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: calc(var(--space-6) + 4px) var(--space-6) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  /* Gradient accent bar across the top (teal → amber), clipped to the card radius */
  .dataset-card-new::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 8px;
    background: linear-gradient(90deg, var(--mosaic-teal), var(--mosaic-amber));
  }
  .dataset-card-new:hover { border-color: var(--mosaic-teal); box-shadow: var(--shadow-card-hover); }
  .dataset-card-badges { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .dataset-card-title { font-size: var(--text-lg); font-weight: 600; color: var(--color-text); line-height: 1.3; margin: 0; }
  .dataset-card-meta { display: flex; flex-direction: column; gap: var(--space-1); margin: 0; }
  .dataset-card-meta div { display: flex; gap: var(--space-2); font-size: var(--text-sm); }
  .dataset-card-meta dt { color: var(--color-muted); font-weight: 500; min-width: 56px; }
  .dataset-card-meta dd { color: var(--color-text); margin: 0; }
  .dataset-card-link { margin-top: auto; font-size: var(--text-sm); font-weight: 600; color: var(--mosaic-teal); text-decoration: none; }

  /* ── Closing CTA — grow the network ────────────────────────── */
  .grow-cta {
    background-color: var(--color-surface);
    padding: var(--space-16) 0;
  }
  .grow-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
    background-color: var(--mosaic-sand);
    border: 1px solid var(--color-border);
    border-radius: 28px;
    box-shadow: 0 14px 35px rgba(8, 90, 117, 0.08);
    padding: var(--space-8) var(--space-12);
  }
  /* Faint dot texture on the right, fading toward the left */
  .grow-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(rgba(8, 90, 117, 0.12) 1.4px, transparent 1.6px);
    background-size: 18px 18px;
    -webkit-mask-image: linear-gradient(to left, #000 0%, transparent 38%);
    mask-image: linear-gradient(to left, #000 0%, transparent 38%);
  }
  .grow-art, .grow-main, .grow-btn { position: relative; z-index: 1; }

  .grow-art { flex-shrink: 0; width: 280px; align-self: stretch; }
  .grow-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 16px;
  }

  .grow-main {
    flex: 1;
    min-width: 280px;
    padding-left: var(--space-8);
    border-left: 1px solid var(--color-border);
  }
  .grow-title { margin: 0 0 var(--space-2); color: var(--mosaic-ink); }
  .grow-body { margin: 0 0 var(--space-6); color: #4B5563; max-width: 52ch; line-height: 1.6; }

  .grow-features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .grow-features li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--mosaic-ink);
    max-width: 17ch;
    line-height: 1.25;
  }
  .grow-feat-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-full);
    background-color: var(--tint-teal-bg);
    color: var(--mosaic-teal);
  }

  .grow-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-bookend);
    color: var(--color-white);
    font-weight: 600;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background-color 0.15s;
    white-space: nowrap;
  }
  .grow-btn:hover { background-color: var(--mosaic-teal-dark); color: var(--color-white); }

  @media (max-width: 900px) {
    .grow-card { gap: var(--space-6); padding: var(--space-8); }
    .grow-main { border-left: none; padding-left: 0; }
