---
import BaseLayout from '../layouts/BaseLayout.astro'
import datasets from '../../data/datasets.json'

const base = import.meta.env.BASE_URL
const totalDatasets = datasets.length
const countries = [...new Set(datasets.map((d) => d.country))].length
const landscapes = [...new Set(datasets.map((d) => d.living_landscape))].length
const featured = datasets.slice(0, 3)

const STATUS_CLASS: Record<string, string> = {
  'Registered only': 'badge-registered',
  'Under review': 'badge-review',
  'Accepted': 'badge-accepted',
  'Validated': 'badge-validated',
  'Analytics-ready': 'badge-analytics',
}
---

<BaseLayout title="Home">

  <!-- ── Hero ──────────────────────────────────────────────────────── -->
  <section class="hero">
    <!-- Topographic contour pattern (decorative) -->
    <div class="hero-topo" aria-hidden="true">
      <svg width="100%" height="100%" viewBox="0 0 1440 560" preserveAspectRatio="xMidYMid slice" fill="none">
        <!-- Horizontal terrain contours -->
        <g stroke="#97BC62" stroke-width="1.4" fill="none">
          <path d="M-100 510 Q200 475 480 500 T960 485 T1600 515" opacity="0.13"/>
          <path d="M-100 460 Q240 420 520 448 T1020 430 T1600 462" opacity="0.15"/>
          <path d="M-100 410 Q280 365 560 395 T1060 375 T1600 408" opacity="0.16"/>
          <path d="M-100 360 Q320 308 600 342 T1100 322 T1600 355" opacity="0.15"/>
          <path d="M-100 310 Q360 252 640 288 T1140 268 T1600 302" opacity="0.14"/>
          <path d="M-100 260 Q400 198 680 234 T1180 215 T1600 250" opacity="0.12"/>
          <path d="M-100 210 Q440 145 720 180 T1220 162 T1600 198" opacity="0.10"/>
          <path d="M-100 160 Q480 92 760 126 T1260 108 T1600 145" opacity="0.08"/>
          <path d="M-100 110 Q520 40 800 74 T1300 56 T1600 92"  opacity="0.06"/>
        </g>
        <!-- Summit contours — tighter nested ellipses right of centre -->
        <g stroke="#97BC62" stroke-width="1" fill="none">
          <ellipse cx="980" cy="310" rx="210" ry="115" opacity="0.10"/>
          <ellipse cx="980" cy="310" rx="165" ry="85"  opacity="0.09"/>
          <ellipse cx="980" cy="310" rx="120" ry="60"  opacity="0.08"/>
          <ellipse cx="980" cy="310" rx="78"  cy="310" rx="78" ry="38"  opacity="0.07"/>
          <ellipse cx="980" cy="310" rx="42"  ry="20"  opacity="0.06"/>
        </g>
      </svg>
    </div>

    <div class="container hero-content">
      <p class="hero-eyebrow">CGIAR MFL Science Programme · Area of Work 2</p>
      <h1 class="hero-headline">Geospatial Data Hub<br/>for Living Landscapes</h1>
      <p class="hero-sub">
        Discover, assess, and contribute spatial datasets from CGIAR centres
        working across nine flagship Living Landscapes in Kenya, Ethiopia, India, and beyond.
      </p>
      <div class="hero-actions">
        <a href={`${base}/catalogue`} class="btn btn-hero-primary">Browse datasets</a>
        <a href={`${base}/contribute`} class="btn btn-hero-ghost">Contribute data</a>
      </div>
    </div>
  </section>

  <!-- ── Stats bar ─────────────────────────────────────────────────── -->
  <section class="stats-section">
    <div class="container stats-grid">
      <div class="stat-item">
        <span class="stat-number">{totalDatasets}</span>
        <span class="stat-label">Datasets catalogued</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-number">{landscapes}</span>
        <span class="stat-label">Living Landscapes</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-number">{countries}</span>
        <span class="stat-label">Priority countries</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-number">10+</span>
        <span class="stat-label">CGIAR centres</span>
      </div>
    </div>
  </section>

  <!-- ── Featured datasets ─────────────────────────────────────────── -->
  <section class="section-white">
    <div class="container">
      <div class="section-header">
        <h2>Featured datasets</h2>
        <a href={`${base}/catalogue`} class="section-link">View all &rarr;</a>
      </div>
      <div class="cards-grid">
        {featured.map((d) => (
          <article class="dataset-card-new">
            <div class="dataset-card-badges">
              <span class={`badge ${STATUS_CLASS[d.readiness_status] ?? ''}`}>{d.readiness_status}</span>
              <span class={`badge badge-${d.access_level.toLowerCase()}`}>{d.access_level}</span>
            </div>
            <h3 class="dataset-card-title">{d.title}</h3>
            <dl class="dataset-card-meta">
              <div>
                <dt>Country</dt>
                <dd>{d.country}</dd>
              </div>
              <div>
                <dt>Theme</dt>
                <dd>{d.mfl_theme}</dd>
              </div>
            </dl>
            <a href={`${base}/catalogue/${d.id}`} class="dataset-card-link">View details &rarr;</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── How it works ──────────────────────────────────────────────── -->
  <section class="section-subtle">
    <div class="container">
      <h2 class="section-title-center">How it works</h2>
      <div class="steps-grid">
        <div class="step-item">
          <span class="step-number">01</span>
          <h3>Browse the catalogue</h3>
          <p>Filter datasets by country, landscape, theme, and readiness status. Each entry shows what data exists and how to access it.</p>
        </div>
        <div class="step-item">
          <span class="step-number">02</span>
          <h3>Access or request data</h3>
          <p>Open datasets are linked directly for download. Restricted datasets show a contact path for access requests.</p>
        </div>
        <div class="step-item">
          <span class="step-number">03</span>
          <h3>Contribute your data</h3>
          <p>CGIAR staff and partners can register and submit datasets through a five-step guided process with metadata support.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Contribute CTA ────────────────────────────────────────────── -->
  <section class="section-cta">
    <div class="container section-cta-inner">
      <div class="cta-text">
        <h2>Have data to share?</h2>
        <p>If you work on geospatial data for a Living Landscape, we want to hear from you. Adding your dataset takes about 30 minutes.</p>
      </div>
      <a href={`${base}/contribute`} class="btn btn-primary">Start contributing</a>
    </div>
  </section>

  <!-- ── About ─────────────────────────────────────────────────────── -->
  <section class="section-white section-about">
    <div class="container section-about-inner">
      <div class="about-label">About</div>
      <h2>MFL Science Programme</h2>
      <p>
        The CGIAR Multifunctional Landscapes (MFL) Science Programme works to restore and sustain
        landscapes that are productive, biodiverse, and resilient. Area of Work 2 focuses on
        landscape optimization and inclusive planning across nine flagship Living Landscapes
        in Kenya, Ethiopia, India, Colombia, and the Mekong region.
      </p>
      <a href={`${base}/about`} class="btn btn-secondary">Learn more about the hub</a>
    </div>
  </section>

</BaseLayout>

<style>
  @import '../styles/catalogue.css';

  /* ── Hero ──────────────────────────────────────────────────── */
  .hero {
    position: relative;
    background-color: #1A3B1B;
    background-image: linear-gradient(160deg, #1A3B1B 0%, #2C5F2D 60%, #1E4A1F 100%);
    color: var(--color-white);
    padding: 6rem 0 5rem;
    overflow: hidden;
  }

  .hero-topo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-topo svg {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 680px;
  }

  .hero-eyebrow {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-green-moss);
    margin-bottom: var(--space-4);
    line-height: 1;
  }

  .hero-headline {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }

  .hero-sub {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.7;
    max-width: 560px;
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .btn-hero-primary {
    background-color: var(--color-cgiar-teal);
    color: var(--color-white);
    border-color: var(--color-cgiar-teal);
    font-weight: 600;
    padding: var(--space-3) var(--space-8);
  }

  .btn-hero-primary:hover {
    background-color: var(--color-cgiar-teal-dark);
    border-color: var(--color-cgiar-teal-dark);
    color: var(--color-white);
  }

  .btn-hero-ghost {
    background-color: transparent;
    color: var(--color-white);
    border: 2px solid rgba(255,255,255,0.4);
    font-weight: 500;
    padding: var(--space-3) var(--space-8);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-base);
    transition: background-color 0.15s, border-color 0.15s;
    cursor: pointer;
  }

  .btn-hero-ghost:hover {
    background-color: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.7);
    color: var(--color-white);
  }

  /* ── Stats ─────────────────────────────────────────────────── */
  .stats-section {
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-gray-100);
    padding: var(--space-8) 0;
  }

  .stats-grid {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-number {
    font-family: var(--font-title);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-cgiar-teal);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stat-label {
    font-size: var(--text-sm);
    color: var(--color-gray-500);
    font-weight: 400;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background-color: var(--color-gray-200);
    flex-shrink: 0;
  }

  /* ── Shared section styles ──────────────────────────────────── */
  .section-white {
    background-color: var(--color-white);
    padding: var(--space-16) 0;
  }

  .section-subtle {
    background-color: var(--color-gray-50);
    padding: var(--space-16) 0;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-8);
    gap: var(--space-4);
  }

  .section-header h2 {
    margin: 0;
  }

  .section-link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-cgiar-teal);
    text-decoration: none;
    white-space: nowrap;
  }

  .section-link:hover {
    color: var(--color-cgiar-teal-dark);
  }

  .section-title-center {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  /* ── Dataset cards ──────────────────────────────────────────── */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  .dataset-card-new {
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .dataset-card-new:hover {
    border-color: var(--color-cgiar-teal);
    box-shadow: 0 4px 16px rgba(0, 156, 166, 0.10);
  }

  .dataset-card-badges {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .dataset-card-title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-gray-900);
    line-height: 1.3;
    margin: 0;
  }

  .dataset-card-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
  }

  .dataset-card-meta div {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .dataset-card-meta dt {
    color: var(--color-gray-400);
    font-weight: 500;
    min-width: 56px;
  }

  .dataset-card-meta dd {
    color: var(--color-gray-700);
    margin: 0;
  }

  .dataset-card-link {
    margin-top: auto;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-cgiar-teal);
    text-decoration: none;
  }

  .dataset-card-link:hover {
    color: var(--color-cgiar-teal-dark);
  }

  /* ── Steps / How it works ───────────────────────────────────── */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-8);
  }

  .step-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .step-number {
    font-family: var(--font-title);
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-gray-200);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .step-item h3 {
    font-size: var(--text-lg);
    margin: 0;
  }

  .step-item p {
    font-size: var(--text-base);
    color: var(--color-gray-600);
    margin: 0;
    line-height: 1.6;
  }

  /* ── CTA section ────────────────────────────────────────────── */
  .section-cta {
    background-color: var(--color-green-dark);
    padding: var(--space-12) 0;
  }

  .section-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .cta-text {
    flex: 1;
    min-width: 240px;
  }

  .cta-text h2 {
    color: var(--color-white);
    margin-bottom: var(--space-2);
    font-size: var(--text-2xl);
  }

  .cta-text p {
    color: rgba(255,255,255,0.70);
    max-width: 480px;
    margin: 0;
    font-size: var(--text-base);
  }

  .section-cta .btn-primary {
    background-color: var(--color-cgiar-teal);
    border-color: var(--color-cgiar-teal);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .section-cta .btn-primary:hover {
    background-color: var(--color-cgiar-teal-dark);
    border-color: var(--color-cgiar-teal-dark);
  }

  /* ── About section ──────────────────────────────────────────── */
  .section-about {
    border-top: 1px solid var(--color-gray-100);
  }

  .section-about-inner {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-cgiar-teal);
  }

  .section-about-inner h2 {
    margin: 0;
  }

  .section-about-inner p {
    color: var(--color-gray-600);
    line-height: 1.7;
    margin: 0;
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .hero { padding: 4rem 0 3.5rem; }
    .stats-grid { gap: var(--space-6); }
    .stat-divider { display: none; }
    .stat-number { font-size: 2rem; }
    .section-cta-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
