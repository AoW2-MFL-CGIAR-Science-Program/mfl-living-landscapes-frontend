---
import BaseLayout from '../../layouts/BaseLayout.astro'
import StatusBadge from '../../components/ui/StatusBadge.astro'
import AccessBadge from '../../components/ui/AccessBadge.astro'
import Breadcrumb from '../../components/ui/Breadcrumb.astro'
import { loadDatasets } from '../../utils/loadDatasets'

export async function getStaticPaths() {
  const datasets = await loadDatasets()
  return datasets.map((d) => ({
    params: { id: d.id },
    props: { dataset: d },
  }))
}

const { dataset } = Astro.props
const base = import.meta.env.BASE_URL

// Related datasets: same landscape and/or theme, best matches first, excluding self.
const allDatasets = await loadDatasets()
const related = allDatasets
  .filter((d) => d.id !== dataset.id &&
    (d.living_landscape === dataset.living_landscape ||
      (!!dataset.mfl_theme && d.mfl_theme === dataset.mfl_theme)))
  .map((d) => ({
    d,
    score: (d.living_landscape === dataset.living_landscape ? 2 : 0) +
      (!!dataset.mfl_theme && d.mfl_theme === dataset.mfl_theme ? 1 : 0),
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 4)
  .map((x) => x.d)

const readinessDescriptions: Record<string, string> = {
  'Raw': 'This dataset is registered as supplied by its source. It has not yet been processed or quality-checked by the MOSAIC network. Metadata may be incomplete.',
  'Processed': 'This dataset has been processed (cleaned, reformatted, or harmonized) but has not yet completed full quality validation against the MFL spatial standards.',
  'Validated': 'This dataset has undergone quality control and meets the MFL spatial standards. Suitable for analysis.',
}
---

<BaseLayout title={dataset.title} description={dataset.description}>
  <div class="container" style="padding-top: var(--space-8); padding-bottom: var(--space-16); max-width: 860px;">

    <!-- Breadcrumb -->
    <Breadcrumb crumbs={[
      { label: 'Home', href: `${base}/` },
      { label: 'Catalogue', href: `${base}/catalogue` },
      { label: dataset.title },
    ]} />

    <!-- Badges -->
    <div style="display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-4);">
      <StatusBadge status={dataset.readiness_status} />
      <AccessBadge access={dataset.access_level} />
      <span style="font-size: var(--text-xs); color: var(--color-gray-600); align-self: center;">{dataset.license}</span>
    </div>

    <!-- Title -->
    <h1 style="margin-bottom: var(--space-6);">{dataset.title}</h1>

    <!-- Description -->
    {dataset.description && (
      <p style="font-size: var(--text-lg); color: var(--color-gray-600); margin-bottom: var(--space-6); max-width: 680px;">{dataset.description}</p>
    )}

    <!-- Trust signals — dataset at a glance -->
    <section class="ds-facts" aria-label="Dataset at a glance">
      <div class="ds-fact">
        <span class="ds-fact-label">Source organization</span>
        <span class="ds-fact-value">{dataset.source ?? 'Not specified'}</span>
      </div>
      <div class="ds-fact">
        <span class="ds-fact-label">Time period</span>
        <span class="ds-fact-value">{dataset.temporal_coverage ?? 'Not specified'}</span>
      </div>
      <div class="ds-fact">
        <span class="ds-fact-label">License</span>
        <span class="ds-fact-value">{dataset.license ?? 'Not specified'}</span>
      </div>
      <div class="ds-fact">
        <span class="ds-fact-label">Access level</span>
        <span class="ds-fact-value">{dataset.access_level ?? 'Not specified'}</span>
      </div>
      <div class="ds-fact">
        <span class="ds-fact-label">Readiness status</span>
        <span class="ds-fact-value">{dataset.readiness_status}</span>
      </div>
      <div class="ds-fact">
        <span class="ds-fact-label">Contact</span>
        <span class="ds-fact-value">
          {dataset.contact
            ? <a href={`mailto:${dataset.contact}`}>{dataset.contact}</a>
            : 'Via the MOSAIC team'}
        </span>
      </div>
      {dataset.download_url && (
        <div class="ds-fact">
          <span class="ds-fact-label">Source link</span>
          <span class="ds-fact-value">
            <a href={dataset.download_url} target="_blank" rel="noopener noreferrer">Go to source ↗</a>
          </span>
        </div>
      )}
    </section>

    <!-- Metadata table -->
    <section style="margin-bottom: var(--space-8);">
      <h2 style="font-size: var(--text-xl); margin-bottom: var(--space-4);">Dataset overview</h2>
      <table class="data-table">
        <tbody>
          <tr><td><strong>Dataset ID</strong></td><td><code>{dataset.id}</code></td></tr>
          <tr><td><strong>Country</strong></td><td>{dataset.country ?? 'Not specified'}</td></tr>
          <tr><td><strong>Living Landscape</strong></td><td>{dataset.landscape_name ? `${dataset.landscape_name} (${dataset.living_landscape})` : dataset.living_landscape}</td></tr>
          <tr><td><strong>MFL Theme</strong></td><td>{dataset.mfl_theme ?? 'Not specified'}</td></tr>
          <tr><td><strong>Data Type</strong></td><td>{dataset.data_type ?? 'Not specified'}</td></tr>
          {dataset.spatial_resolution && <tr><td><strong>Spatial Resolution</strong></td><td>{dataset.spatial_resolution}</td></tr>}
          {dataset.temporal_coverage && <tr><td><strong>Temporal Coverage</strong></td><td>{dataset.temporal_coverage}</td></tr>}
          {dataset.source && <tr><td><strong>Source</strong></td><td>{dataset.source}</td></tr>}
          {dataset.formats && dataset.formats.length > 0 && <tr><td><strong>Formats</strong></td><td>{dataset.formats.join(', ')}</td></tr>}
          <tr><td><strong>Access Level</strong></td><td>{dataset.access_level ?? 'Not specified'}</td></tr>
          <tr><td><strong>License</strong></td><td>{dataset.license ?? 'Not specified'}</td></tr>
          <tr><td><strong>Readiness Status</strong></td><td>{dataset.readiness_status}</td></tr>
        </tbody>
      </table>
    </section>

    <!-- STAC metadata pointer -->
    <section style="margin-bottom: var(--space-8);">
      <h2 style="font-size: var(--text-xl); margin-bottom: var(--space-3);">Full metadata record</h2>
      {dataset.metadata_url ? (
        <p>
          The canonical metadata for this dataset is published as a STAC Item.
          <br />
          <a href={dataset.metadata_url} target="_blank" rel="noopener noreferrer" style="color: var(--mosaic-teal); font-weight: 600;">View STAC metadata (JSON)</a>
          <br />
          <code style="font-size: var(--text-xs); color: var(--color-gray-600); word-break: break-all;">{dataset.metadata_url}</code>
        </p>
      ) : (
        <p style="color: var(--color-gray-600);">No STAC metadata record is registered for this dataset yet.</p>
      )}
    </section>

    <!-- Access section -->
    <section style="margin-bottom: var(--space-8); padding: var(--space-6); background-color: var(--mosaic-light-teal); border-radius: var(--radius-lg);">
      <h2 style="font-size: var(--text-xl); margin-bottom: var(--space-3);">How to access this dataset</h2>
      {dataset.access_level === 'Open' ? (
        <div>
          <p style="margin-bottom: var(--space-4);">
            This dataset is openly available{dataset.license ? ` under the ${dataset.license} license` : ''}.
            MOSAIC connects to the source rather than re-hosting the data.
          </p>
          {dataset.download_url
            ? <a href={dataset.download_url} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Go to source</a>
            : <p style="margin-bottom: var(--space-2);">No direct source link has been registered yet. See the contact below or the STAC metadata record above.</p>}
          {dataset.contact && <p style="margin-top: var(--space-3);"><strong>Contact:</strong> <a href={`mailto:${dataset.contact}`}>{dataset.contact}</a></p>}
        </div>
      ) : dataset.access_level === 'Restricted' ? (
        <div>
          <p style="margin-bottom: var(--space-4);">Access to this dataset is restricted. To request access, please contact the data steward.</p>
          {dataset.contact
            ? <p><strong>Contact:</strong> <a href={`mailto:${dataset.contact}`}>{dataset.contact}</a></p>
            : <p>No steward contact is registered yet. Contact the MOSAIC coordination team.</p>}
        </div>
      ) : dataset.access_level === 'Internal' ? (
        <div>
          <p style="margin-bottom: var(--space-4);">This dataset is for internal CGIAR use only. Contact the MOSAIC team if you believe you should have access.</p>
          {dataset.contact && <p><strong>Contact:</strong> <a href={`mailto:${dataset.contact}`}>{dataset.contact}</a></p>}
        </div>
      ) : (
        <div>
          <p style="margin-bottom: var(--space-4);">The access level for this dataset has not been specified yet. Contact the data steward or the MOSAIC coordination team for details.</p>
          {dataset.contact && <p><strong>Contact:</strong> <a href={`mailto:${dataset.contact}`}>{dataset.contact}</a></p>}
        </div>
      )}
    </section>

    <!-- Readiness explanation -->
    <section style="margin-bottom: var(--space-8);">
      <h2 style="font-size: var(--text-xl); margin-bottom: var(--space-3);">About the readiness status</h2>
      <p><strong>{dataset.readiness_status}:</strong> {readinessDescriptions[dataset.readiness_status]}</p>
    </section>

    <!-- Citation -->
    <section style="margin-bottom: var(--space-8); padding: var(--space-6); background-color: var(--color-gray-50); border-left: 4px solid var(--mosaic-teal); border-radius: 0 var(--radius-md) var(--radius-md) 0;">
      <h2 style="font-size: var(--text-lg); margin-bottom: var(--space-3);">Suggested citation</h2>
      <p style="font-size: var(--text-sm); font-family: var(--font-mono); color: var(--color-gray-600); line-height: 1.7;">
        {dataset.citation?.trim()
          ? dataset.citation
          : `${dataset.source ?? 'CGIAR'} (${dataset.temporal_coverage ?? new Date().getFullYear()}). ${dataset.title}. MOSAIC — CGIAR MFL Science Programme. Retrieved from https://aow2-mfl-cgiar-science-program.github.io/mfl-living-landscapes-frontend/catalogue/${dataset.id}`}
      </p>
    </section>

    <!-- Status legend (collapsible) -->
    <details style="margin-bottom: var(--space-8); border: 1px solid var(--color-gray-200); border-radius: var(--radius-md); padding: var(--space-4);">
      <summary style="cursor: pointer; font-weight: 600; color: var(--mosaic-teal);">Readiness status legend</summary>
      <table class="data-table" style="margin-top: var(--space-4);">
        <thead>
          <tr><th>Status</th><th>Meaning</th></tr>
        </thead>
        <tbody>
          <tr><td><span class="badge badge-raw">Raw</span></td><td>Registered as supplied by the source; not yet processed or quality-checked. Metadata may be incomplete.</td></tr>
          <tr><td><span class="badge badge-processed">Processed</span></td><td>Cleaned, reformatted, or harmonized, but not yet fully validated against the MFL spatial standards.</td></tr>
          <tr><td><span class="badge badge-validated">Validated</span></td><td>Passed quality control and meets the MFL spatial standards. Suitable for analysis.</td></tr>
        </tbody>
      </table>
    </details>

    <!-- Related datasets -->
    {related.length > 0 && (
      <section style="margin-bottom: var(--space-8);">
        <h2 style="font-size: var(--text-xl); margin-bottom: var(--space-4);">Related datasets</h2>
        <ul style="list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3);">
          {related.map((r) => (
            <li>
              <a href={`${base}/catalogue/${r.id}`} style="display: flex; flex-direction: column; gap: 2px; padding: var(--space-4); border: 1px solid var(--color-gray-200); border-radius: var(--radius-md); text-decoration: none; color: inherit;">
                <span style="font-weight: 600; color: var(--color-gray-900);">{r.title}</span>
                <span style="font-size: var(--text-sm); color: var(--color-gray-500);">{r.landscape_name ?? r.living_landscape}{r.mfl_theme ? ` · ${r.mfl_theme}` : ''}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Back link -->
    <a id="back-to-catalogue" href={`${base}/catalogue`} style="color: var(--mosaic-teal); font-size: var(--text-sm);">&larr; Back to catalogue</a>
  </div>

  <script is:inline define:vars={{ base }}>
    // Restore the catalogue view (filters/search/sort) the visitor came from.
    try {
      const qs = sessionStorage.getItem('mosaic:catalogue:qs')
      if (qs) {
        const link = document.getElementById('back-to-catalogue')
        if (link) link.setAttribute('href', `${base}/catalogue?${qs}`)
      }
    } catch (_) { /* storage unavailable */ }
  </script>
</BaseLayout>

<style>
  @import '../../styles/catalogue.css';
</style>
