---
import BaseLayout from '../../layouts/BaseLayout.astro'
import StatusBadge from '../../components/ui/StatusBadge.astro'
import AccessBadge from '../../components/ui/AccessBadge.astro'
import { loadDatasets } from '../../utils/loadDatasets'

export async function getStaticPaths() {
  const datasets = await loadDatasets()
  return datasets.map((d) => ({
    params: { id: d.id },
    props: { dataset: d },
  }))
}

const { dataset } = Astro.props
const base = import.meta.env.BASE_URL

const readinessDescriptions: Record<string, string> = {
  'Registered only': 'This dataset has been registered in the catalogue but has not yet been reviewed. Metadata may be incomplete.',
  'Under review': 'This dataset is currently being reviewed by the MOSAIC team. Check back soon for an updated status.',
  'Accepted': 'This dataset has passed initial review. Metadata is complete and the dataset is considered reliable for reference use.',
  'Validated': 'This dataset has undergone quality control and meets the MFL spatial standards. Suitable for analysis.',
  'Analytics-ready': 'This dataset has been processed, harmonized, and validated to the highest standard. Ready for use in landscape analytics and modelling.',
}
---

<BaseLayout title={dataset.title} description={dataset.description}>
  <div class="container" style="padding-top: var(--space-8); padding-bottom: var(--space-16); max-width: 860px;">

    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" style="font-size: var(--text-sm); color: var(--color-gray-400); margin-bottom: var(--space-6);">
      <a href={`${base}/catalogue`} style="color: var(--mosaic-teal);">Catalogue</a>
      <span style="margin: 0 var(--space-2);">/</span>
      <span>{dataset.title}</span>
    </nav>

    <!-- Badges -->
    <div style="display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-4);">
      <StatusBadge status={dataset.readiness_status} />
      <AccessBadge access={dataset.access_level} />
      <span style="font-size: var(--text-xs); color: var(--color-gray-600); align-self: center;">{dataset.license}</span>
    </div>

    <!-- Title -->
    <h1 style="margin-bottom: var(--space-6);">{dataset.title}</h1>

    <!-- Description -->
    {dataset.description && (
      <p style="font-size: var(--text-lg); color: var(--color-gray-600); margin-bottom: var(--space-8); max-width: 680px;">{dataset.description}</p>
    )}

    <!-- Metadata table -->
    <section style="margin-bottom: var(--space-8);">
      <h2 style="font-size: var(--text-xl); margin-bottom: var(--space-4);">Dataset overview</h2>
      <table class="data-table">
        <tbody>
          <tr><td><strong>Dataset ID</strong></td><td><code>{dataset.id}</code></td></tr>
          <tr><td><strong>Country</strong></td><td>{dataset.country}</td></tr>
          <tr><td><strong>Living Landscape</strong></td><td>{dataset.living_landscape}</td></tr>
          <tr><td><strong>MFL Theme</strong></td><td>{dataset.mfl_theme}</td></tr>
          <tr><td><strong>Data Type</strong></td><td>{dataset.data_type}</td></tr>
          {dataset.spatial_resolution && <tr><td><strong>Spatial Resolution</strong></td><td>{dataset.spatial_resolution}</td></tr>}
          {dataset.temporal_coverage && <tr><td><strong>Temporal Coverage</strong></td><td>{dataset.temporal_coverage}</td></tr>}
          {dataset.source && <tr><td><strong>Source</strong></td><td>{dataset.source}</td></tr>}
          <tr><td><strong>Access Level</strong></td><td>{dataset.access_level}</td></tr>
          <tr><td><strong>License</strong></td><td>{dataset.license}</td></tr>
          <tr><td><strong>Readiness Status</strong></td><td>{dataset.readiness_status}</td></tr>
          {dataset.metadata_url && <tr><td><strong>Metadata Record</strong></td><td><a href={dataset.metadata_url}>View full metadata</a></td></tr>}
        </tbody>
      </table>
    </section>

    <!-- Access section -->
    <section style="margin-bottom: var(--space-8); padding: var(--space-6); background-color: var(--mosaic-light-teal); border-radius: var(--radius-lg);">
      <h2 style="font-size: var(--text-xl); margin-bottom: var(--space-3);">How to access this dataset</h2>
      {dataset.access_level === 'Open' && dataset.download_url ? (
        <div>
          <p style="margin-bottom: var(--space-4);">This dataset is openly available for download under the {dataset.license} license.</p>
          <a href={dataset.download_url} class="btn btn-primary">Download dataset</a>
        </div>
      ) : dataset.access_level === 'Restricted' ? (
        <div>
          <p style="margin-bottom: var(--space-4);">Access to this dataset is restricted. To request access, please contact the data steward.</p>
          {dataset.contact && <p><strong>Contact:</strong> <a href={`mailto:${dataset.contact}`}>{dataset.contact}</a></p>}
        </div>
      ) : (
        <div>
          <p style="margin-bottom: var(--space-4);">This dataset is for internal CGIAR use only. Contact the MOSAIC team if you believe you should have access.</p>
          {dataset.contact && <p><strong>Contact:</strong> <a href={`mailto:${dataset.contact}`}>{dataset.contact}</a></p>}
        </div>
      )}
    </section>

    <!-- Readiness explanation -->
    <section style="margin-bottom: var(--space-8);">
      <h2 style="font-size: var(--text-xl); margin-bottom: var(--space-3);">About the readiness status</h2>
      <p><strong>{dataset.readiness_status}:</strong> {readinessDescriptions[dataset.readiness_status]}</p>
    </section>

    <!-- Citation -->
    <section style="margin-bottom: var(--space-8); padding: var(--space-6); background-color: var(--color-gray-50); border-left: 4px solid var(--mosaic-teal); border-radius: 0 var(--radius-md) var(--radius-md) 0;">
      <h2 style="font-size: var(--text-lg); margin-bottom: var(--space-3);">Suggested citation</h2>
      <p style="font-size: var(--text-sm); font-family: monospace; color: var(--color-gray-600); line-height: 1.7;">
        {dataset.source ?? 'CGIAR'} ({dataset.temporal_coverage ?? new Date().getFullYear()}). {dataset.title}. MOSAIC — CGIAR MFL Science Programme. Retrieved from https://aow2-mfl-cgiar-science-program.github.io/mfl-living-landscapes-frontend/catalogue/{dataset.id}
      </p>
    </section>

    <!-- Status legend (collapsible) -->
    <details style="margin-bottom: var(--space-8); border: 1px solid var(--color-gray-200); border-radius: var(--radius-md); padding: var(--space-4);">
      <summary style="cursor: pointer; font-weight: 600; color: var(--mosaic-teal);">Readiness status legend</summary>
      <table class="data-table" style="margin-top: var(--space-4);">
        <thead>
          <tr><th>Status</th><th>Meaning</th></tr>
        </thead>
        <tbody>
          <tr><td><span class="badge badge-registered">Registered only</span></td><td>Dataset registered; metadata may be incomplete. Not yet reviewed.</td></tr>
          <tr><td><span class="badge badge-review">Under review</span></td><td>Metadata submitted; MOSAIC team is reviewing for completeness and accuracy.</td></tr>
          <tr><td><span class="badge badge-accepted">Accepted</span></td><td>Metadata reviewed and approved. Dataset is reliable for reference use.</td></tr>
          <tr><td><span class="badge badge-validated">Validated</span></td><td>Dataset has passed spatial QC checks. Suitable for analysis.</td></tr>
          <tr><td><span class="badge badge-analytics">Analytics-ready</span></td><td>Fully harmonized and validated. Ready for landscape analytics and modelling.</td></tr>
        </tbody>
      </table>
    </details>

    <!-- Back link -->
    <a href={`${base}/catalogue`} style="color: var(--mosaic-teal); font-size: var(--text-sm);">&larr; Back to catalogue</a>
  </div>
</BaseLayout>

<style>
  @import '../../styles/catalogue.css';
</style>
