---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/ui/PageHero.astro'
import StatCard from '../../components/ui/StatCard.astro'
import { CatalogueFilter } from '../../components/catalogue/CatalogueFilter'
import LandscapeLocatorMap from '../../components/catalogue/LandscapeLocatorMap.astro'
import { loadDatasets } from '../../utils/loadDatasets'

const datasets = await loadDatasets()
const base = import.meta.env.BASE_URL

const totalDatasets = datasets.length
const landscapes = [...new Set(datasets.map((d) => d.living_landscape))].length
const countries   = [...new Set(datasets.map((d) => d.country))].length
---

<BaseLayout
  title="Dataset Catalogue"
  description="Browse and filter geospatial datasets from CGIAR centres across MFL Living Landscapes."
>
  <div class="catalogue-page">

    <!-- ── Hero ──────────────────────────────────────────────── -->
    <PageHero
      variant="light"
      title="Dataset Catalogue"
      subtitle="Explore geospatial datasets connected through MOSAIC across MFL Living Landscapes in Africa, Asia, and Latin America."
    >
      <img slot="art" src={`${base}/illustrations/hero-catalogue.jpg`} alt="" />
    </PageHero>

    <!-- ── Stats ─────────────────────────────────────────────── -->
    <div class="catalogue-stats">
      <StatCard icon="layers" value={totalDatasets} label="Datasets" tint="teal" />
      <StatCard icon="map-pin" value={landscapes} label="Landscapes" tint="amber" />
      <StatCard icon="globe" value={countries} label="Countries" tint="terracotta" />
    </div>

    <!-- ── Locator map ───────────────────────────────────────── -->
    <div class="catalogue-locator-wrap">
      <LandscapeLocatorMap />
    </div>

    <!-- ── Filter + Results ──────────────────────────────────── -->
    <noscript>
      <div class="catalogue-locator-wrap" style="padding-bottom: 0;">
        <p style="background: var(--mosaic-light-teal); border-radius: var(--radius-md); padding: var(--space-4) var(--space-5); color: var(--color-gray-700); font-size: var(--text-sm);">
          Interactive search and filtering need JavaScript. You can still reach the full,
          machine-readable catalogue through the
          <a href="https://aow2-mfl-cgiar-science-program.github.io/MOSAIC_catalog/stac/catalog.json" style="color: var(--mosaic-teal); font-weight: 600;">STAC endpoint</a>
          — the source of truth MOSAIC connects to.
        </p>
      </div>
    </noscript>
    <CatalogueFilter client:visible datasets={datasets} base={base} />

  </div>
</BaseLayout>

<style is:global>
  @import '../../styles/catalogue.css';
</style>
