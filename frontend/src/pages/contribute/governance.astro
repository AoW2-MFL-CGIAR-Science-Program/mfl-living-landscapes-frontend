---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/ui/PageHero.astro'
import Breadcrumb from '../../components/ui/Breadcrumb.astro'
const base = import.meta.env.BASE_URL
---

<BaseLayout title="Governance & Access" description="Access tier definitions, contributor eligibility, and governance rules for the MFL Living Landscapes Data Hub.">
  <PageHero title="Governance & Access" subtitle="Who can contribute, how access decisions are made, and who is responsible for what." />
  <div class="container">
    <Breadcrumb crumbs={[
      { label: 'Home', href: `${base}/` },
      { label: 'Contribute', href: `${base}/contribute` },
      { label: 'Governance & Access' },
    ]} />
  </div>

  <div class="container" style="padding-top: var(--space-12); padding-bottom: var(--space-16); max-width: 800px;">

    <section style="margin-bottom: var(--space-12);">
      <h2 style="margin-bottom: var(--space-6);">Access tiers</h2>
      <table class="data-table">
        <thead>
          <tr>
            <th>Access Level</th>
            <th>Who can access</th>
            <th>How to access</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><span class="badge badge-open">Open</span></td>
            <td>Anyone — the dataset is publicly available</td>
            <td>Direct download link on the dataset detail page</td>
          </tr>
          <tr>
            <td><span class="badge badge-restricted">Restricted</span></td>
            <td>Approved users — access is granted by the contributing centre</td>
            <td>Contact email shown on the dataset detail page; access decision made by the data owner</td>
          </tr>
          <tr>
            <td><span class="badge badge-internal">Internal</span></td>
            <td>CGIAR staff only — for datasets not ready for external sharing</td>
            <td>Contact the hub team; verification of CGIAR affiliation required</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section style="margin-bottom: var(--space-12);">
      <h2 style="margin-bottom: var(--space-4);">Who can contribute</h2>
      <p style="color: var(--color-gray-600); margin-bottom: var(--space-4);">
        The following groups are eligible to register and contribute datasets:
      </p>
      <ul style="list-style: disc; padding-left: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); color: var(--color-gray-600);">
        <li>Staff at CGIAR centres that are members of the MFL Science Programme</li>
        <li>Programme partners and national partners working directly with a CGIAR centre on a Living Landscape</li>
        <li>Postdoctoral researchers and consultants contracted to a CGIAR centre for MFL-related work</li>
      </ul>
      <p style="color: var(--color-gray-600); margin-top: var(--space-4);">
        If you are not sure whether you are eligible, contact the hub coordinator via the <a href={`${base}/contact`}>Contact</a> page.
      </p>
    </section>

    <section style="margin-bottom: var(--space-12);">
      <h2 style="margin-bottom: var(--space-4);">How access decisions are made</h2>
      <p style="color: var(--color-gray-600); margin-bottom: var(--space-4);">
        Access level decisions are made by the contributing centre, not by the hub team. The hub team records and displays the access level that the contributor declares. If you are a data user and believe a dataset's access level is incorrect, contact the contributing centre directly using the contact email shown on the dataset detail page.
      </p>
      <p style="color: var(--color-gray-600);">
        The hub team does not override access level decisions made by contributing centres.
      </p>
    </section>

    <section style="margin-bottom: var(--space-12);">
      <h2 style="margin-bottom: var(--space-4);">Hub team contacts</h2>
      <table class="data-table">
        <thead>
          <tr><th>Role</th><th>Name</th><th>Contact</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>Hub Coordinator</td>
            <td>Lizeth Llanos</td>
            <td>Alliance of Bioversity-CIAT — contact via GitHub Issues</td>
          </tr>
          <tr>
            <td>Technical Lead</td>
            <td>AoW2 MFL Team</td>
            <td>Contact via GitHub Issues</td>
          </tr>
        </tbody>
      </table>
      <p style="font-size: var(--text-sm); color: var(--color-gray-500); margin-top: var(--space-3);">
        This governance page will be updated with full contact details once the hub team is confirmed.
      </p>
    </section>

    <section>
      <h2 style="margin-bottom: var(--space-4);">Data ownership and licensing</h2>
      <p style="color: var(--color-gray-600); margin-bottom: var(--space-4);">
        Data ownership remains with the contributing CGIAR centre or organisation. The hub only catalogues metadata and links to the data; it does not host data files. Each dataset entry must carry a license — contributing centres are responsible for ensuring the declared license reflects their centre's data sharing policy.
      </p>
      <p style="color: var(--color-gray-600);">
        The hub website code and content (excluding linked datasets) is licensed under CC BY 4.0. You are free to share and adapt the hub's documentation and content with attribution.
      </p>
    </section>

  </div>
</BaseLayout>

<style>
  @import '../../styles/catalogue.css';
</style>
