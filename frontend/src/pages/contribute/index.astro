---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/ui/PageHero.astro'
import Icon from '../../components/ui/Icon.astro'
import StickyNote from '../../components/ui/StickyNote.astro'
import StepTimeline from '../../components/ui/StepTimeline.astro'
import CtaBand from '../../components/ui/CtaBand.astro'

const base = import.meta.env.BASE_URL
// The catalogue's submission form (MOSAIC_catalog repo — records/<ID>.yaml is
// the source of truth; submissions become validated record files via PR).
const newDatasetUrl = 'https://github.com/AoW2-MFL-CGIAR-Science-Program/MOSAIC_catalog/issues/new?template=new_dataset.yml'
const updateIssueUrl = 'https://github.com/AoW2-MFL-CGIAR-Science-Program/MOSAIC_catalog/issues/new'
const howToUrl = 'https://github.com/AoW2-MFL-CGIAR-Science-Program/MOSAIC_catalog/blob/main/docs/HOW_TO_REGISTER_DATASETS.md'

const checklist = [
  'Required: a dataset title, the Living Landscape it covers (or country-wide / global), the country, and a contact person',
  'A working download or source URL — the single biggest boost to reusability',
  'Spatial resolution with units (e.g. "30 m", "0.05°") and the coordinate reference system (e.g. EPSG:4326)',
  'Temporal coverage (e.g. 2017–2025), a license (e.g. CC BY 4.0) and file format(s)',
  'An access level decision (Open, Restricted, or Internal)',
  'A short description covering method, caveats and related datasets',
]

const steps = [
  { num: '01', icon: 'upload', title: 'Register', body: 'Submit the form — only title, landscape, country and contact are required. Partial metadata is fine; the rest can be completed later.' },
  { num: '02', icon: 'file-text', title: 'Record drafted', body: 'The MOSAIC team turns your submission into a validated record file — one per dataset, version-controlled with a permanent ID.' },
  { num: '03', icon: 'eye', title: 'Review & refine', body: 'You are tagged on the pull request to confirm the details and fill any gaps.' },
  { num: '04', icon: 'check-circle', title: 'Validation', body: 'Automated checks run on every change — nothing invalid can be published.' },
  { num: '05', icon: 'globe', title: 'Published', body: 'On merge, the catalogue and the STAC endpoint republish automatically (about 2 minutes) and your dataset gets a stable, citable metadata URL.' },
]

const faqs = [
  { q: 'Do I need to upload my data files to GitHub?', a: 'No. MOSAIC is a catalogue, not a file repository. Your data files stay wherever they are hosted (e.g. a CGIAR data portal, Google Drive, institutional server). The record describes your dataset and points to where it lives.' },
  { q: 'Can I register a dataset before the data is publicly available?', a: 'Yes. You can register a dataset with Internal or Restricted access. This makes the dataset discoverable in the catalogue while access is managed through your centre\'s normal procedures.' },
  { q: 'What if my dataset doesn\'t fit the controlled vocabulary?', a: 'Contact the MOSAIC team via the Contact page. The controlled vocabularies are reviewed periodically and new values can be proposed.' },
  { q: 'What if I don\'t know a field?', a: 'Leave it empty. An incomplete-but-honest record is far more useful than nothing — the catalogue flags gaps rather than hiding them, and you can fill them in later.' },
  { q: 'How long does the review process take?', a: 'Metadata review typically takes 5–10 working days. Spatial QC (for Validated status) may take longer depending on the dataset and the QC team\'s capacity. Once a record is merged, publication itself is automatic — about 2 minutes.' },
  { q: 'Can I update a dataset entry after it is published?', a: 'Yes. Open an issue on the MOSAIC catalogue repository describing what needs to change — or, if you are comfortable with Git, edit the dataset\'s record file and open a pull request. Every change is reviewed and validated before it goes live, and each dataset\'s full history stays visible; records are never silently changed.' },
]
---

<BaseLayout title="Contribute a dataset" description="Share a geospatial dataset with MOSAIC — open to institutions, researchers and landscape initiatives.">
  <PageHero
    variant="light"
    title="Contribute a dataset"
    subtitle="Share geospatial data so researchers, institutions and landscape teams can discover and use it."
    subtitle2="You can start with partial metadata and complete it later — the MOSAIC team will help review and prepare the catalogue entry."
  >
    <img slot="art" src={`${base}/illustrations/hero-home.jpg`} alt="" />
  </PageHero>

  <div class="container contrib-body">

    <!-- 1 & 2 · Who can contribute + What data can be added -->
    <div class="contrib-prose contrib-intro">
      <section>
        <h2>Who can contribute?</h2>
        <p>MOSAIC welcomes contributions from research institutions, universities, public agencies, NGOs, landscape initiatives, CGIAR centres, partner organizations and independent researchers working with relevant landscape data.</p>
        <p>Some datasets may require validation, attribution, licensing checks or access restrictions before publication.</p>
        <p>If you are not sure whether your dataset fits MOSAIC, <a href={`${base}/contact`}>contact the coordination team</a> before submitting.</p>
      </section>
      <section>
        <h2>What data can be added?</h2>
        <p>Geospatial datasets related to a living landscape — for example land cover and land use, soil and land health, water and hydrology, biodiversity, ecosystem services, agrobiodiversity, or socio-economic layers. Raster, vector and tabular data are all welcome.</p>
        <p>MOSAIC catalogues the metadata and links to the data; your files stay wherever they are already hosted.</p>
      </section>
    </div>

    <!-- 3 · Before you start — checklist -->
    <section class="checklist-card">
      <div class="checklist-intro">
        <span class="checklist-icon" aria-hidden="true"><Icon name="check-square" size={28} /></span>
        <h2>Before you start — quick checklist</h2>
        <p>Only the first item is strictly required — the rest make your record far more findable and reusable:</p>
        <StickyNote tint="teal" rotate={-2}>Don't worry if you're not sure about everything. You can always come back and edit later!</StickyNote>
      </div>
      <div class="checklist-list">
        <ul>
          {checklist.map((item) => (
            <li>
              <span class="checklist-tick" aria-hidden="true"><Icon name="check-square" size={18} /></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="checklist-foot">
          See the <a href={`${base}/contribute/metadata-guide`}>Metadata Guide</a> for full descriptions of all fields.
        </p>
      </div>
    </section>

    <!-- 4 · Start dataset submission -->
    <section class="contrib-start">
      <h2>Start dataset submission</h2>
      <p>You can start with partial metadata and complete it later. The MOSAIC team turns your submission into a validated catalogue record and reviews it with you.</p>
      <div class="contrib-start-actions">
        <a class="btn btn-primary" href={newDatasetUrl} target="_blank" rel="noopener noreferrer">Register a new dataset</a>
        <a class="btn btn-secondary" href={`${base}/contact`}>Ask before contributing</a>
      </div>
      <p class="contrib-start-note">
        Submissions are managed through GitHub — a free account is the only prerequisite. If you are not
        familiar with GitHub, <a href={`${base}/contact`}>contact the MOSAIC team</a> and they can guide you.
        Updating an existing dataset instead? <a href={updateIssueUrl} target="_blank" rel="noopener noreferrer">Open an update issue</a>.
      </p>
    </section>

    <!-- 5 · What happens after you submit -->
    <section class="contrib-process">
      <h2 class="contrib-h2 center">What happens after you submit</h2>
      <StepTimeline steps={steps} />
    </section>

    <!-- 6, 7, 8, 9 · Other ways, QC, ownership, FAQ -->
    <div class="contrib-prose">
      <section>
        <h2>Other ways to contribute</h2>
        <p>The submission form above is the recommended route, but it is not the only one:</p>
        <ul class="bullets">
          <li>
            <strong>Comfortable with Git?</strong> Every dataset is one version-controlled record file in the
            MOSAIC catalogue repository — copy an existing record, edit the fields and open a pull request.
            Every change is validated automatically, so you can't break the catalogue.
          </li>
          <li>
            <strong>Many datasets at once?</strong> Don't type them one by one — send your centre's inventory
            (a spreadsheet, an internal catalogue) to the <a href={`${base}/contact`}>MOSAIC coordinator</a> and
            we'll run a scripted import and return the draft records for your review.
          </li>
        </ul>
        <p>
          Full instructions for all three routes:
          <a href={howToUrl} target="_blank" rel="noopener noreferrer">How to register a dataset (GitHub)</a>.
        </p>
      </section>

      <section>
        <h2>Quality control &amp; validation</h2>
        <p>
          After a dataset is accepted, the MOSAIC team runs spatial quality control: the data is opened and read,
          the coordinate reference system is checked, and the spatial extent and temporal coverage are confirmed
          against the stated Living Landscape and period. The current stage of this process is shown as the
          <strong> readiness status</strong> on each catalogue entry and dataset page.
        </p>
        <p>
          If metadata review or spatial QC reveals issues, the MOSAIC team opens a GitHub issue and tags the contributor.
          The dataset stays at its current status until the issues are resolved, and is never removed from the catalogue
          without notifying the contributor.
        </p>
      </section>

      <section>
        <h2>Data ownership &amp; licensing</h2>
        <p>
          Data ownership remains with the contributing CGIAR centre or organisation. MOSAIC only catalogues metadata and
          links to the data; it does not host data files. Each dataset entry must carry a license, and contributing centres
          are responsible for ensuring the declared license reflects their centre's data-sharing policy. Access-level
          decisions are made by the contributing centre — see the <a href={`${base}/contribute/metadata-guide`}>Metadata Guide</a>
          for the access tiers.
        </p>
        <p>MOSAIC website code and content (excluding linked datasets) is licensed under CC BY 4.0.</p>
      </section>

      <section>
        <h2>Frequently asked questions</h2>
        {faqs.map((item) => (
          <details class="faq">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </section>
    </div>

  </div>

  <CtaBand
    variant="soft"
    tint="sand"
    title="Your data has the power to create change."
    body="By contributing, you help build a shared resource that supports research, restoration and better outcomes for people and nature across the globe."
    primaryCta={{ label: 'Register a new dataset', href: newDatasetUrl, target: '_blank' }}
    secondaryCta={{ label: 'View metadata guide', href: `${base}/contribute/metadata-guide` }}
  >
    <img slot="art" src={`${base}/illustrations/seedling.png`} alt="" />
    <StickyNote slot="sticky" tint="amber" rotate={3}>Thank you for being part of the MOSAIC community!</StickyNote>
  </CtaBand>

  <CtaBand
    variant="bar"
    icon="help-circle"
    title="Need help?"
    body="Check our Metadata Guide or contact the MOSAIC team."
    primaryCta={{ label: 'Contact us', href: `${base}/contact` }}
  />
</BaseLayout>

<style>
  .contrib-body {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  /* Checklist card */
  .checklist-card {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: var(--space-8);
    padding: var(--space-8);
    background-color: var(--color-gray-50);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    margin-bottom: var(--space-16);
  }
  .checklist-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-full);
    background-color: var(--tint-teal-bg);
    color: var(--tint-teal-fg);
    margin-bottom: var(--space-3);
  }
  .checklist-intro h2 { margin: 0 0 var(--space-2); font-size: var(--text-2xl); }
  .checklist-intro p { color: var(--color-muted); margin: 0 0 var(--space-4); }
  .checklist-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .checklist-list li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    color: var(--color-text);
    line-height: 1.5;
  }
  .checklist-tick { color: var(--mosaic-teal); flex-shrink: 0; display: inline-flex; margin-top: 1px; }
  .checklist-foot { margin: var(--space-4) 0 0; font-size: var(--text-sm); color: var(--color-muted); }
  .checklist-foot a, .contrib-prose a { color: var(--mosaic-teal); }

  /* Intro prose (Who / What) */
  .contrib-intro { margin-bottom: var(--space-16); }

  /* Start dataset submission */
  .contrib-start {
    max-width: 760px;
    margin: 0 auto var(--space-16);
    text-align: center;
  }
  .contrib-start h2 { margin: 0 0 var(--space-3); }
  .contrib-start > p { color: var(--color-muted); line-height: 1.7; margin: 0 auto var(--space-6); max-width: 60ch; }
  .contrib-start-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .contrib-start-note { font-size: var(--text-sm); color: var(--color-muted); max-width: 56ch; margin: 0 auto; }
  .contrib-start-note a { color: var(--mosaic-teal); }

  /* Process */
  .contrib-process { margin-bottom: var(--space-16); }
  .contrib-h2.center { text-align: center; margin-bottom: var(--space-8); }

  /* Supporting prose */
  .contrib-prose {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .contrib-prose h2 { margin: 0 0 var(--space-4); }
  .contrib-prose p { color: var(--color-muted); line-height: 1.7; margin: 0 0 var(--space-4); }
  .contrib-prose p:last-child { margin-bottom: 0; }
  .contrib-prose .bullets {
    list-style: disc;
    padding-left: var(--space-6);
    color: var(--color-muted);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
  }
  .faq {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-bottom: var(--space-3);
    background-color: var(--color-surface);
  }
  .faq summary { cursor: pointer; font-weight: 600; color: var(--color-text); }
  .faq p { margin: var(--space-3) 0 0; }

  @media (max-width: 767px) {
    .checklist-card { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>
