---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/ui/PageHero.astro'
import StickyNote from '../../components/ui/StickyNote.astro'
import StepTimeline from '../../components/ui/StepTimeline.astro'
import CtaBand from '../../components/ui/CtaBand.astro'

const base = import.meta.env.BASE_URL
// The catalogue's submission form (MOSAIC_catalog repo — records/<ID>.yaml is
// the source of truth; submissions become validated record files via PR).
const newDatasetUrl = 'https://github.com/AoW2-MFL-CGIAR-Science-Program/MOSAIC_catalog/issues/new?template=new_dataset.yml'
const updateIssueUrl = 'https://github.com/AoW2-MFL-CGIAR-Science-Program/MOSAIC_catalog/issues/new'
const howToUrl = 'https://github.com/AoW2-MFL-CGIAR-Science-Program/MOSAIC_catalog/blob/main/docs/HOW_TO_REGISTER_DATASETS.md'

const steps = [
  { num: '01', icon: 'upload', title: 'Register', body: 'Fill the form: title, living landscape, country, contact. Everything else is optional — empty is a valid answer.' },
  { num: '02', icon: 'eye', title: 'Review — together', body: 'The MOSAIC team turns your submission into a validated record and tags you to confirm the details. Typically 5–10 working days.' },
  { num: '03', icon: 'globe', title: 'Published', body: 'Everything republishes automatically in about 2 minutes: permanent ID, STAC metadata, and a page in the catalogue.' },
]

const required = [
  'Dataset title',
  'Living Landscape it covers (or country-wide / global)',
  'Country',
  'Contact person',
]

const recommended = [
  'A working download or source URL — the single biggest boost to reusability',
  'Spatial resolution with units (e.g. "30 m") and the CRS (e.g. EPSG:4326)',
  'Temporal coverage, a license (e.g. CC BY 4.0) and file format(s)',
]

const faqs = [
  { q: 'Do I need to upload my data files?', a: 'Not for now. Today MOSAIC is a catalogue: your data stays wherever it is hosted (a CGIAR data portal, an institutional server, a drive) and the record describes it and points to it. In a later phase, the plan is to make the open datasets themselves directly available through MOSAIC — datasets that already have a home will keep being linked at their source.' },
  { q: 'Can I register a dataset before the data is publicly available?', a: 'Yes. Register it with Internal or Restricted access: the dataset becomes discoverable while access itself stays managed through your centre\'s normal procedures.' },
  { q: 'What if my dataset doesn\'t fit the controlled vocabulary?', a: 'Contact the MOSAIC team via the Contact page. The controlled vocabularies are reviewed periodically and new values can be proposed.' },
  { q: 'What does quality control check?', a: 'After acceptance, the MOSAIC team opens and reads the data, checks the coordinate reference system, and confirms the spatial extent and time period against the record. The current stage shows as the readiness status on each dataset page. If issues appear, you are tagged on a GitHub issue — a dataset is never removed without notifying the contributor.' },
  { q: 'Can I update a dataset after it is published?', a: 'Yes. Open an update issue describing the change — or, if you use Git, edit the dataset\'s record file and open a pull request. Every change is validated before going live and each record\'s history stays visible.' },
  { q: 'Who owns the data — and the license?', a: 'Ownership stays with the contributing centre or organisation, now and in any future phase. Each record carries the license the contributor declares, and access-level decisions are the contributor\'s. (The website\'s own content is CC BY 4.0.)' },
]
---

<BaseLayout title="Contribute a dataset" description="Register a geospatial dataset in the MOSAIC catalogue — 4 required fields, about 2 minutes.">
  <PageHero
    variant="light"
    title="Contribute a dataset"
    subtitle="Register your dataset's metadata and it becomes an open, citable record — permanent ID, STAC metadata and its own page in the catalogue."
  >
    <div class="hero-actions">
      <a class="btn btn-primary" href={newDatasetUrl} target="_blank" rel="noopener noreferrer">Register a new dataset</a>
      <a class="btn btn-secondary" href={`${base}/contact`}>Ask before contributing</a>
    </div>
    <p class="hero-note">4 required fields · about 2 minutes · a free GitHub account is the only prerequisite</p>
    <img slot="art" src={`${base}/illustrations/hero-home.jpg`} alt="" />
  </PageHero>

  <div class="container contrib-body">

    <!-- Open-audience strip (public positioning: contribution is open) -->
    <p class="contrib-open">
      <strong>Open to everyone working on living landscapes</strong> — research institutions, universities,
      public agencies, NGOs, landscape initiatives and independent researchers. Any landscape-related
      geospatial data: raster, vector or tabular. Your files stay where they are — MOSAIC publishes
      metadata that points to them.
    </p>

    <!-- How it works -->
    <section class="contrib-process" id="how-it-works">
      <h2 class="contrib-h2 center">How it works</h2>
      <StepTimeline steps={steps} />
    </section>

    <!-- What you need -->
    <section class="need-card">
      <div class="need-col">
        <h2>Required <span class="need-count">4 fields</span></h2>
        <ul>
          {required.map((item) => (
            <li><span class="need-tick req" aria-hidden="true">✓</span><span>{item}</span></li>
          ))}
        </ul>
      </div>
      <div class="need-col">
        <h2>Recommended</h2>
        <ul>
          {recommended.map((item) => (
            <li><span class="need-tick" aria-hidden="true">＋</span><span>{item}</span></li>
          ))}
        </ul>
        <p class="need-foot">
          Full field descriptions: <a href={`${base}/contribute/metadata-guide`}>Metadata Guide</a>.
        </p>
      </div>
      <div class="need-sticky">
        <StickyNote tint="teal" rotate={-2}>Not sure about a field? Leave it empty — you can always come back and edit later.</StickyNote>
      </div>
    </section>

    <!-- Other ways -->
    <section class="contrib-prose">
      <h2>Other ways to contribute</h2>
      <ul class="bullets">
        <li>
          <strong>Comfortable with Git?</strong> Each dataset is one record file in the
          <a href="https://github.com/AoW2-MFL-CGIAR-Science-Program/MOSAIC_catalog" target="_blank" rel="noopener noreferrer">catalogue repository</a> —
          copy one, edit it, open a pull request. Validation runs automatically, so you can't break the catalogue.
        </li>
        <li>
          <strong>Many datasets at once?</strong> Send your centre's inventory (a spreadsheet is fine) to the
          <a href={`${base}/contact`}>MOSAIC coordinator</a> — we run a scripted import and return draft records for your review.
        </li>
        <li>
          <strong>Updating an existing dataset?</strong> <a href={updateIssueUrl} target="_blank" rel="noopener noreferrer">Open an update issue</a> describing the change.
        </li>
      </ul>
      <p>
        Step-by-step instructions for all routes:
        <a href={howToUrl} target="_blank" rel="noopener noreferrer">How to register a dataset</a>.
      </p>
    </section>

    <!-- FAQ -->
    <section class="contrib-prose">
      <h2>Frequently asked questions</h2>
      {faqs.map((item) => (
        <details class="faq">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </section>

  </div>

  <CtaBand
    variant="soft"
    tint="sand"
    title="Put your dataset on the map."
    body="Every record makes the landscapes' shared evidence base stronger — and your work citable and findable."
    primaryCta={{ label: 'Register a new dataset', href: newDatasetUrl, target: '_blank' }}
    secondaryCta={{ label: 'Contact the MOSAIC team', href: `${base}/contact` }}
  >
    <img slot="art" src={`${base}/illustrations/seedling.png`} alt="" />
    <StickyNote slot="sticky" tint="amber" rotate={3}>Thank you for being part of the MOSAIC community!</StickyNote>
  </CtaBand>
</BaseLayout>

<style>
  .contrib-body {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  /* Hero actions (rendered inside PageHero's default slot) */
  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }
  .hero-note {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* Open-audience strip */
  .contrib-open {
    max-width: 760px;
    margin: 0 auto var(--space-16);
    text-align: center;
    color: var(--color-muted);
    line-height: 1.7;
  }
  .contrib-open strong { color: var(--color-text); }

  /* Process */
  .contrib-process { margin-bottom: var(--space-16); }
  .contrib-h2.center { text-align: center; margin-bottom: var(--space-8); }

  /* What you need */
  .need-card {
    display: grid;
    grid-template-columns: 1fr 1.3fr auto;
    gap: var(--space-8);
    align-items: start;
    padding: var(--space-8);
    background-color: var(--color-gray-50);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    margin-bottom: var(--space-16);
  }
  .need-col h2 { margin: 0 0 var(--space-4); font-size: var(--text-2xl); }
  .need-count {
    display: inline-block;
    margin-left: var(--space-2);
    padding: 2px 10px;
    border-radius: var(--radius-full);
    background-color: var(--tint-teal-bg);
    color: var(--tint-teal-fg);
    font-size: var(--text-sm);
    font-weight: 600;
    vertical-align: middle;
  }
  .need-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .need-col li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    line-height: 1.5;
  }
  .need-tick {
    flex-shrink: 0;
    font-weight: 700;
    color: var(--color-muted);
  }
  .need-tick.req { color: var(--mosaic-teal); }
  .need-foot { margin: var(--space-4) 0 0; font-size: var(--text-sm); color: var(--color-muted); }
  .need-foot a { color: var(--mosaic-teal); }
  .need-sticky { align-self: center; }

  /* Supporting prose */
  .contrib-prose {
    max-width: 760px;
    margin: 0 auto var(--space-16);
  }
  .contrib-prose:last-child { margin-bottom: 0; }
  .contrib-prose h2 { margin: 0 0 var(--space-4); }
  .contrib-prose p { color: var(--color-muted); line-height: 1.7; margin: 0 0 var(--space-4); }
  .contrib-prose p:last-child { margin-bottom: 0; }
  .contrib-prose a { color: var(--mosaic-teal); }
  .contrib-prose .bullets {
    list-style: disc;
    padding-left: var(--space-6);
    color: var(--color-muted);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    line-height: 1.6;
  }
  .faq {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-bottom: var(--space-3);
    background-color: var(--color-surface);
  }
  .faq summary { cursor: pointer; font-weight: 600; color: var(--color-text); }
  .faq p { margin: var(--space-3) 0 0; }

  @media (max-width: 992px) {
    .need-card { grid-template-columns: 1fr 1fr; }
    .need-sticky { grid-column: 1 / -1; justify-self: center; }
  }
  @media (max-width: 767px) {
    .need-card { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>
