---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/ui/PageHero.astro'
---

<BaseLayout title="QC Workflow" description="The MFL Living Landscapes Data Hub quality control process for dataset validation.">
  <PageHero title="Quality Control Workflow" subtitle="How datasets move from registration to Analytics-ready." />

  <div class="container" style="padding-top: var(--space-12); padding-bottom: var(--space-16); max-width: 800px;">

    <p style="font-size: var(--text-lg); color: var(--color-gray-600); margin-bottom: var(--space-12); max-width: 680px;">
      Every dataset in the hub passes through up to five quality control stages. The current stage is shown as the readiness status badge on each catalogue entry and detail page.
    </p>

    {[
      {
        status: 'Registered only',
        badgeClass: 'badge-registered',
        title: 'Stage 1 — Registration',
        timeline: 'Immediate',
        criteria: [
          'Dataset title is provided',
          'Country and Living Landscape code are valid',
          'MFL theme is selected',
          'Access level is set',
          'License is specified',
        ],
        note: 'Metadata may be incomplete at this stage. Registration confirms the dataset exists and is in scope for the hub.',
      },
      {
        status: 'Under review',
        badgeClass: 'badge-review',
        title: 'Stage 2 — Metadata review',
        timeline: '5–10 working days',
        criteria: [
          'All required fields are present and non-empty',
          'All controlled vocabulary values are valid',
          'Description is present and readable',
          'Source and contact are provided',
          'Open datasets have a valid download_url',
        ],
        note: 'The hub team will contact the contributor to resolve any gaps or errors.',
      },
      {
        status: 'Accepted',
        badgeClass: 'badge-accepted',
        title: 'Stage 3 — Acceptance',
        timeline: 'Follows metadata review',
        criteria: [
          'Metadata review is complete with no outstanding issues',
          'Dataset entry is merged into the catalogue',
          'Dataset is visible and browseable in the catalogue',
        ],
        note: 'Accepted datasets are reliable for reference use. Spatial QC has not yet been performed.',
      },
      {
        status: 'Validated',
        badgeClass: 'badge-validated',
        title: 'Stage 4 — Spatial validation',
        timeline: '10–20 working days (depends on dataset size)',
        criteria: [
          'Dataset can be opened and read by the QC team',
          'Coordinate reference system is documented and correct',
          'Spatial extent matches the stated Living Landscape boundary',
          'Temporal coverage matches the stated period',
          'No major data gaps or artefacts in the spatial coverage',
        ],
        note: 'Spatial validation is performed by the hub QC team. Contributors may be asked to provide the dataset in a standard format.',
      },
      {
        status: 'Analytics-ready',
        badgeClass: 'badge-analytics',
        title: 'Stage 5 — Analytics-ready',
        timeline: 'Follows spatial validation (varies)',
        criteria: [
          'Dataset has been reprojected to a common CRS if required',
          'Attribute table or band names are standardised',
          'Dataset is compatible with programme analysis workflows',
          'No known data quality issues',
        ],
        note: 'Analytics-ready datasets have been harmonized for use in landscape-level analysis and modelling. Not all datasets will reach this stage.',
      },
    ].map((stage) => (
      <div style="margin-bottom: var(--space-8); padding: var(--space-6); border: 1px solid var(--color-gray-200); border-radius: var(--radius-lg);">
        <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4);">
          <span class={`badge ${stage.badgeClass}`}>{stage.status}</span>
          <span style="font-size: var(--text-xs); color: var(--color-gray-400);">Typical timeline: {stage.timeline}</span>
        </div>
        <h3 style="margin-bottom: var(--space-3);">{stage.title}</h3>
        <ul style="list-style: disc; padding-left: var(--space-6); display: flex; flex-direction: column; gap: var(--space-2); color: var(--color-gray-600); font-size: var(--text-sm); margin-bottom: var(--space-4);">
          {stage.criteria.map((c) => <li>{c}</li>)}
        </ul>
        <p style="font-size: var(--text-sm); color: var(--color-gray-500); font-style: italic;">{stage.note}</p>
      </div>
    ))}

    <section style="margin-top: var(--space-8); padding: var(--space-6); background-color: var(--color-cream); border-radius: var(--radius-lg);">
      <h2 style="margin-bottom: var(--space-3);">What happens if a dataset fails review?</h2>
      <p style="color: var(--color-gray-600);">
        If metadata review or spatial QC reveals issues, the hub team will open a GitHub issue on the repository and tag the contributor. The dataset stays at its current status until the issues are resolved. Datasets are never removed from the catalogue without notifying the contributor.
      </p>
    </section>

  </div>
</BaseLayout>

<style>
  @import '../../styles/catalogue.css';
</style>
