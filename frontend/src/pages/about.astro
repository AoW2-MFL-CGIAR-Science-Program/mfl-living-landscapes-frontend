---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/ui/PageHero.astro'
import IconChip from '../components/ui/IconChip.astro'
import ContentCard from '../components/ui/ContentCard.astro'
import InfoCallout from '../components/ui/InfoCallout.astro'
import StickyNote from '../components/ui/StickyNote.astro'
import Icon from '../components/ui/Icon.astro'

const base = import.meta.env.BASE_URL

const pillars = [
  { icon: 'link', label: 'Connect', caption: 'Linking global data with local datasets across landscapes.', tint: 'teal' },
  { icon: 'users', label: 'Collaborate', caption: 'Bringing together people, centres and data.', tint: 'amber' },
  { icon: 'search', label: 'Discover', caption: 'Find the right data, at the right time, with confidence.', tint: 'light-teal' },
  { icon: 'sparkles', label: 'Create impact', caption: 'Turning spatial information into better decisions for people and nature.', tint: 'terracotta' },
] as const

/* Acknowledgements — official CGIAR / Science Programme lockups, used as supplied
   and always on a white plate so they show in CGIAR's own colours in both themes
   (MOSAIC Brand Guidelines v1.0, §5 — never recoloured or recreated). The images
   are decorative: each card's heading already names the institution. */
const acknowledgements = [
  {
    logo: 'cgiar-logo-full.png',
    width: 600,
    height: 269,
    title: 'CGIAR',
    text: 'MOSAIC is developed within CGIAR, the global research partnership for a food-secure future. This work is carried out with support from the CGIAR Trust Fund and the funders who contribute to it.',
  },
  {
    logo: 'cgiar-mfl-lockup.png',
    width: 2048,
    height: 687,
    title: 'Multifunctional Landscapes Science Programme',
    text: 'The CGIAR Multifunctional Landscapes (MFL) Science Programme hosts and funds MOSAIC, under its work on landscape optimization and inclusive planning, and through the MFL Geospatial Community of Practice that maintains the catalogue.',
  },
  {
    logo: 'cgiar-climate-action-lockup.png',
    width: 600,
    height: 288,
    title: 'Climate Action Science Programme',
    text: 'We acknowledge the CGIAR Climate Action Science Programme and the collaboration on shared metadata standards with the CGIAR Climate Data Hub, which keeps climate layers discoverable through MOSAIC while they remain maintained at their source.',
  },
] as const

const notList = [
  'Hosting or storing data files',
  'Replacing existing data services or catalogues',
  'Being the single source of all geospatial data in the world',
]
---

<BaseLayout title="About" description="About MOSAIC — what it is, who it serves, and what it is not.">
  <PageHero
    variant="light"
    title="About MOSAIC"
    subtitle="An open geospatial data network for living landscapes."
    subtitle2="MOSAIC helps institutions, researchers and landscape initiatives connect datasets, improve discoverability and support evidence-based decisions — with support from the CGIAR Multifunctional Landscapes Science Programme."
  >
    <img slot="art" src={`${base}/illustrations/hero-home.jpg`} alt="" />
  </PageHero>

  <!-- Pillars -->
  <div class="container about-pillars">
    {pillars.map((p) => (
      <IconChip icon={p.icon} label={p.label} caption={p.caption} tint={p.tint} align="center" />
    ))}
  </div>

  <div class="container about-body">

    <!-- What MOSAIC is -->
    <section class="about-split">
      <div class="about-split-text">
        <h2 class="about-h2">What MOSAIC is<svg class="wavy" width="64" height="8" viewBox="0 0 64 8" fill="none" aria-hidden="true"><path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg></h2>
        <p>
          MOSAIC is an open geospatial data network for living landscapes — a catalogue and set of
          connectors that make it easier to discover, compare and use spatial data from many sources.
          It is built by the CGIAR Multifunctional Landscapes Science Programme and open to the wider
          community working on living landscapes.
        </p>
        <p>
          It is the data discovery and contribution layer for the CGIAR Multifunctional Landscapes
          Science Programme. Its guiding principle is to connect, not duplicate: linking to the
          global data services the world already maintains and combining them with the local datasets
          only CGIAR holds.
        </p>
        <p>
          MOSAIC makes it possible to find out what geospatial data exists across the programme, who
          produced it, at what resolution and time period, and how to access it. Each dataset entry
          carries a readiness status that tells you how far along the quality control process it is —
          from first registration through to analytics-ready.
        </p>
        <p>
          MOSAIC is a catalogue, not a file repository. Data files remain hosted by the contributing
          CGIAR centre and are linked from the catalogue entry. This keeps data ownership and
          maintenance with the people who know the data best.
        </p>
      </div>
      <div class="about-split-art" aria-hidden="true">
        <img src={`${base}/illustrations/network-diagram.png`} alt="" />
      </div>
    </section>

    <!-- Who it serves -->
    <section class="about-serves">
      <h2 class="about-h2">Who it serves<svg class="wavy" width="64" height="8" viewBox="0 0 64 8" fill="none" aria-hidden="true"><path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg></h2>
      <p class="about-lead">MOSAIC serves anyone working with data for living landscapes — across institutions, disciplines and roles. Two groups use it most:</p>
      <div class="about-cards">
        <ContentCard icon="users" title="Data users" tint="teal">
          Researchers, GIS analysts, decision-makers and landscape teams who need to know what
          geospatial data exists for a landscape, whether it is available, and how to get it.
        </ContentCard>
        <ContentCard icon="upload" title="Data contributors" tint="amber">
          Institutions, data stewards and focal points — at CGIAR centres, universities, agencies,
          NGOs and landscape initiatives — who produce datasets and want to make them findable,
          documented and reusable.
        </ContentCard>
      </div>
    </section>

    <!-- Open to the wider community -->
    <InfoCallout variant="note-teal" icon="leaf">
      MOSAIC is open to the wider community working on living landscapes — research institutions,
      universities, public agencies, NGOs, landscape initiatives and independent researchers.
      Appropriately licensed datasets can be discovered, cited and reused, with access managed by
      each data owner.
      <img slot="art" src={`${base}/illustrations/hand-with-sprout.png`} alt="" />
    </InfoCallout>

    <!-- What it is not -->
    <section class="about-not">
      <div class="about-not-art" aria-hidden="true">
        <img src={`${base}/illustrations/signpost.png`} alt="" />
      </div>
      <div class="about-not-body">
        <h2 class="about-h2 about-h2--terracotta">What it is not<svg class="wavy" width="64" height="8" viewBox="0 0 64 8" fill="none" aria-hidden="true"><path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg></h2>
        <ul class="about-not-list">
          {notList.map((item) => (
            <li>
              <span class="about-not-icon" aria-hidden="true"><Icon name="x-circle" size={22} /></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="about-not-closing">
          Our goal is simple: connect what exists, make it easy to find, and help data create impact.
          MOSAIC connects you to the source of truth — it never tries to become it.
        </p>
        <StickyNote tint="amber" rotate={-3}>Have ideas? Want to get involved? We'd love to hear from you!</StickyNote>
      </div>
    </section>

    <!-- Programme context + CoP (retained) -->
    <div class="about-prose">
      <section>
        <h2>Programme context</h2>
        <p>
          The CGIAR Multifunctional Landscapes (MFL) Science Programme works to restore and sustain
          landscapes that are simultaneously productive, biodiverse, and resilient, across flagship
          Living Landscapes and a broader network of strategic landscapes. The programme develops
          spatially informed approaches to characterize ecosystem condition, identify landscape
          stress, and support the prioritization of action.
          MOSAIC is the coordination network that connects this work across centres.
        </p>
        <a href={`${base}/landscapes`} class="btn btn-secondary">View Living Landscapes</a>
      </section>

      <section>
        <h2>Geospatial Community of Practice</h2>
        <p>
          MOSAIC is maintained by the MFL Geospatial Community of Practice, a network of over 230
          geospatial specialists and data stewards across CGIAR centres. Focal points in each centre
          register and validate datasets for their landscapes. If you are a centre focal point and want
          to contribute data, start at the <a href={`${base}/contribute`}>How to contribute</a> page.
        </p>
      </section>
    </div>

    <!-- Acknowledgements -->
    <section class="about-ack" id="acknowledgements">
      <h2 class="about-h2">Acknowledgements<svg class="wavy" width="64" height="8" viewBox="0 0 64 8" fill="none" aria-hidden="true"><path d="M1 4 Q9 1 17 4 T33 4 T49 4 T63 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg></h2>
      <p class="about-lead">
        MOSAIC is a collective effort. We gratefully acknowledge the institutions and science
        programmes that make this work possible.
      </p>
      <div class="ack-cards">
        {acknowledgements.map((a) => (
          <div class="ack-card">
            <div class="ack-logo">
              <img src={`${base}/${a.logo}`} alt="" width={a.width} height={a.height} aria-hidden="true" />
            </div>
            <h3 class="ack-title">{a.title}</h3>
            <p class="ack-text">{a.text}</p>
          </div>
        ))}
      </div>
      <p class="about-ack-note">
        For the full list of CGIAR funders, see <a href="https://www.cgiar.org/funders/" target="_blank" rel="noopener noreferrer">cgiar.org/funders</a>.
      </p>
    </section>

  </div>
</BaseLayout>

<style>
  /* Pillars */
  .about-pillars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    padding-top: var(--space-12);
    padding-bottom: var(--space-4);
  }

  /* Short colour line under each pillar, tinted to match its icon
     (kept identical to the former home pillars). */
  .about-pillars :global(.icon-chip)::after {
    content: "";
    width: 36px;
    height: 3px;
    margin-top: var(--space-4);
    border-radius: var(--radius-full);
    background: var(--chip-fg);
  }

  .about-body {
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .about-h2 {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
  }
  .wavy { color: var(--mosaic-teal); }
  .about-h2--terracotta .wavy { color: var(--mosaic-terracotta); }

  /* What MOSAIC is */
  .about-split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-8);
    align-items: center;
  }
  .about-split-text p { color: var(--color-muted); line-height: 1.7; margin: 0 0 var(--space-4); }
  .about-split-text p:last-child { margin-bottom: 0; }
  .about-split-art img { display: block; width: 100%; height: auto; }

  /* Who it serves */
  .about-lead { color: var(--color-muted); margin: 0 0 var(--space-6); max-width: 60ch; }
  .about-cards { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); }

  /* Acknowledgements */
  .ack-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }

  .ack-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  /* White plate for the official lockups — stays white in dark mode (as in the
     footer endorsement), because --color-white is deliberately not remapped. */
  .ack-logo {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    min-height: 104px;
  }
  /* Sized by width so the three horizontal lockups read at a comparable optical
     weight, with a height cap for the taller (two-square) ones. */
  .ack-logo img { display: block; width: auto; height: auto; max-width: 160px; max-height: 72px; object-fit: contain; }

  .ack-title {
    margin: 0;
    font-size: var(--text-lg);
    font-family: var(--font-title);
    color: var(--color-text);
    line-height: 1.3;
  }
  .ack-text { margin: 0; font-size: var(--text-sm); color: var(--color-muted); line-height: 1.6; }

  .about-ack-note { color: var(--color-muted); font-size: var(--text-sm); margin: var(--space-6) 0 0; }
  .about-ack-note a { color: var(--mosaic-teal); }
  /* Ocean Teal is too dark to read on the dark surface — use the light tint of
     the same brand colour there (the accent itself is never restyled). */
  :global([data-theme="dark"]) .about-ack-note a { color: var(--mosaic-light-teal); }

  /* What it is not */
  .about-not {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-8);
    align-items: center;
  }
  .about-not-art img { display: block; width: 100%; max-width: 360px; height: auto; margin: 0 auto; }
  .about-not-list { list-style: none; margin: 0 0 var(--space-6); padding: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .about-not-list li { display: flex; gap: var(--space-3); align-items: center; color: var(--color-text); }
  .about-not-icon { color: var(--mosaic-terracotta); flex-shrink: 0; display: inline-flex; }
  .about-not-closing { color: var(--color-muted); line-height: 1.7; margin: 0 0 var(--space-6); max-width: 60ch; }

  /* Retained prose */
  .about-prose { max-width: 760px; display: flex; flex-direction: column; gap: var(--space-8); }
  .about-prose h2 { margin: 0 0 var(--space-3); }
  .about-prose p { color: var(--color-muted); line-height: 1.7; margin: 0 0 var(--space-4); }
  .about-prose a:not(.btn) { color: var(--mosaic-teal); }

  @media (max-width: 1023px) {
    .ack-cards { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 767px) {
    .about-pillars { grid-template-columns: 1fr 1fr; }
    .ack-cards { grid-template-columns: 1fr; }
    .about-split, .about-not, .about-cards { grid-template-columns: 1fr; }
    .about-not-art { order: -1; }
  }
  @media (max-width: 480px) {
    .about-pillars { grid-template-columns: 1fr; }
  }
</style>
