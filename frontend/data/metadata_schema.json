{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aow2-mfl-cgiar-science-program.github.io/mfl-living-landscapes-frontend/schema/dataset.json",
  "title": "MFL Dataset Metadata Record",
  "description": "Schema for a single dataset entry in frontend/data/datasets.json. Aligned with MOSAIC vocab_reconciliation.md v1. Only id, title, living_landscape and readiness_status are strictly required; remaining controlled-vocabulary fields may be null for records whose source metadata is incomplete or flagged for repair.",
  "type": "object",
  "required": ["id", "title", "living_landscape", "readiness_status"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier.",
      "example": "MFL-2026-000"
    },
    "title": { "type": "string", "description": "Human-readable dataset name" },
    "country": {
      "type": ["string", "null"],
      "enum": [
        "Colombia", "Côte d'Ivoire", "Ethiopia", "India", "Kenya", "Laos",
        "Peru", "Senegal", "Tanzania", "Tunisia", "Vietnam", "Zimbabwe", null
      ]
    },
    "living_landscape": {
      "type": "string",
      "enum": [
        "MEK-3S", "IND-CH", "SEN-FK", "KEN-NAT", "ZWE-MB", "CIV-NZ",
        "TUN-NW", "ETH-OG", "COL-NAT", "PER-NAT", "LAO-NAT", "VNM-NAT", "GLB-UNSPEC"
      ]
    },
    "mfl_theme": {
      "type": ["string", "null"],
      "enum": [
        "Boundaries / admin units", "Land cover / land use", "Ecosystem condition",
        "Degradation / land health", "Water / hydrology", "Biodiversity / ecosystems",
        "Pressures / drivers", "Ecosystem services", "Hotspots / leverage points",
        "Scenarios / future risks", "Decision-support outputs", "Agrobiodiversity / crops",
        "Socio-economic / livelihoods", null
      ]
    },
    "data_type": {
      "type": ["string", "null"],
      "enum": ["Raster", "Vector", "Tabular", "Mixed", null]
    },
    "access_level": {
      "type": ["string", "null"],
      "enum": ["Open", "CGIAR-internal", "Restricted", null]
    },
    "license": { "type": ["string", "null"] },
    "readiness_status": {
      "type": "string",
      "enum": ["Raw", "Processed", "Validated"]
    },
    "description": { "type": ["string", "null"] },
    "source": { "type": ["string", "null"] },
    "contact": {
      "type": ["string", "null"],
      "description": "Steward email address, or null when not supplied."
    },
    "spatial_resolution": { "type": ["string", "null"] },
    "temporal_coverage": { "type": ["string", "null"] },
    "formats": {
      "type": "array",
      "items": { "type": "string" }
    },
    "download_url": {
      "type": ["string", "null"],
      "description": "External source URL, or null. MOSAIC connects to sources rather than re-hosting data; an Open record need not have a direct download_url."
    },
    "metadata_url": {
      "type": ["string", "null"],
      "description": "Relative path to the dataset's STAC Item JSON within the catalogue (e.g. stac/collections/IND-CH/items/MFL-2026-000.json). Not an absolute URI."
    }
  }
}
