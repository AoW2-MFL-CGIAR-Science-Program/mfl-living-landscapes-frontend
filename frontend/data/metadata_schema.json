{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aow2-mfl-cgiar-science-program.github.io/mfl-living-landscapes-frontend/schema/dataset.json",
  "title": "MFL Dataset Metadata Record",
  "description": "Schema for a single dataset entry in frontend/data/datasets.json",
  "type": "object",
  "required": ["id", "title", "country", "living_landscape", "mfl_theme", "data_type", "access_level", "license", "readiness_status"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier. Format: {LANDSCAPE}_{THEME-CODE}_{YEAR}_{SOURCE}_{VERSION}",
      "example": "KEN-LV_LC_2023_ILRI_v1"
    },
    "title": { "type": "string", "description": "Human-readable dataset name" },
    "country": {
      "type": "string",
      "enum": ["Kenya", "Ethiopia", "India", "Colombia", "Myanmar", "Vietnam", "Laos", "Cambodia", "Thailand"]
    },
    "living_landscape": {
      "type": "string",
      "enum": ["KEN-LV", "KEN-MT", "ETH-GT", "ETH-BL", "IND-WG", "IND-EP", "COL-AM", "MEK-LM"]
    },
    "mfl_theme": {
      "type": "string",
      "enum": [
        "Boundaries / admin units", "Land cover / land use", "Ecosystem condition",
        "Degradation / land health", "Water / hydrology", "Biodiversity / ecosystems",
        "Pressures / drivers", "Ecosystem services", "Hotspots / leverage points",
        "Scenarios / future risks", "Decision-support outputs", "Agrobiodiversity / crops",
        "Socio-economic / livelihoods"
      ]
    },
    "data_type": {
      "type": "string",
      "enum": ["Raster", "Vector", "Tabular", "Time series", "Model output", "Survey data"]
    },
    "access_level": { "type": "string", "enum": ["Open", "Restricted", "Internal"] },
    "license": { "type": "string", "minLength": 1 },
    "readiness_status": {
      "type": "string",
      "enum": ["Registered only", "Under review", "Accepted", "Validated", "Analytics-ready"]
    },
    "description": { "type": "string" },
    "source": { "type": "string" },
    "contact": { "type": "string", "format": "email" },
    "spatial_resolution": { "type": "string" },
    "temporal_coverage": { "type": "string" },
    "download_url": { "type": "string", "format": "uri" },
    "metadata_url": { "type": "string", "format": "uri" }
  }
}
